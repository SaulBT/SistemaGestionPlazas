@model SGPla.Models.DTOs.Usuarios.CrearUsuarioDTO
@using SGPla.Commons

@{
    ViewData["Title"] = "Crear Usuario";
}

<h1>Crear Usuario</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Correo" class="control-label"></label>
                <input asp-for="Correo" class="form-control" type="email" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cargo" class="control-label"></label>
                <input asp-for="Cargo" class="form-control" />
                <span asp-validation-for="Cargo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Rol" class="control-label"></label>
                <select id="RolSelect" name="Rol" class="form-control" onchange="mostrarCombo(this.value)">
                    <option value="">-- Seleccione un rol --</option>
                    <option value="DGAA">Coordinador DGAA</option>
                    <option value="EA">Coordinador de Entidad Académica</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>

            <div id="AreaAcademicaDiv" style="display: none;">
                <div class="form-group mb-3">
                    <label asp-for="IdAreaAcademica" class="control-label">Área Académica</label>
                    <select asp-for="IdAreaAcademica" class="form-control" asp-items="ViewBag.AreasAcademicas">
                        <option value="">-- Seleccione un área académica --</option>
                    </select>
                    <span asp-validation-for="IdAreaAcademica" class="text-danger"></span>
                </div>
            </div>

            <div id="EntidadAcademicaDiv" style="display: none;">
                <div class="form-group mb-3">
                    <label asp-for="IdEntidadAcademica" class="control-label">Entidad Académica</label>
                    <select asp-for="IdEntidadAcademica" class="form-control" asp-items="ViewBag.EntidadesAcademicas">
                        <option value="">-- Seleccione una entidad académica --</option>
                    </select>
                    <span asp-validation-for="IdEntidadAcademica" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Crear</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        function mostrarCombo(valor) {
            var areaDiv = document.getElementById('AreaAcademicaDiv');
            var entidadDiv = document.getElementById('EntidadAcademicaDiv');
            
            areaDiv.style.display = 'none';
            entidadDiv.style.display = 'none';
            
            if (valor === 'DGAA') {
                areaDiv.style.display = 'block';
            } else if (valor === 'EA') {
                entidadDiv.style.display = 'block';
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            var select = document.getElementById('RolSelect');
            mostrarCombo(select.value);
        });
    </script>
}