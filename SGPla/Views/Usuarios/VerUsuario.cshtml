@model SGPla.Models.DTOs.Usuarios.DetallesUsuarioDTO

@{
    ViewData["Title"] = "Ver Usuario";
    ViewBag.RegresarUrl = Url.Action("Index", "Usuarios");
}

<!-- Campos -->
<div style="padding-bottom:var(--padding-end); ">
    <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:center; justify-content:space-between; background-color:var(--bg-gris)">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "nombre",
            Name = "nombre",
            Label = "Nombre:",
            Valor = Model.Nombre,
            Disabled = true,
            Flexible = true
        })
    </div>

    <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:center; justify-content:space-between; background-color:var(--bg-gris)">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "cargo",
            Name = "cargo",
            Label = "Cargo:",
            Valor = Model.Cargo,
            Disabled = true,
            Flexible = true
        })

        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "correo",
            Name = "correo",
            Label = "Correo:",
            Valor = Model.Correo,
            Disabled = true,
            Flexible = true
        })

        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "rol",
            Name = "rol",
            Label = "Rol:",
            Valor = Model.Rol,
            Disabled = true,
            Flexible = true
        })
    </div>

    <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:center; justify-content:space-between; background-color:var(--bg-gris)">
        <div id="contenedorRegion" style="width:100%">
            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Id = "region",
                Name = "region",
                Label = "Región:",
                Valor = Model.Region,
                Disabled = true,
                Flexible = true
            })
        </div>

        <div style="width:100%">
            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Id = "areaAcademica",
                Name = "areaAcademica",
                Label = "Área Académica:",
                Valor = Model.NombreAreaAcademica,
                Disabled = true,
                Flexible = true
            })
        </div>
        
        <div id="contenedorEntidad" style="width:100%">
            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Id = "entidadAcademica",
                Name = "entidadAcademica",
                Label = "Entidad Académica:",
                Valor = Model.NombreEntidadAcademica,
                Disabled = true,
                Flexible = true
            })
        </div>
    </div>
</div>

<!-- Botón Regresar -->
<div>
    <a href="@Url.Action("Index", "Usuarios")" style="display: inline-block; text-decoration: none;">
        @await Component.InvokeAsync("Boton", new
        {
            Accion = "Regresar"
        })
    </a>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Obtener referencias a los elementos
        const contenedorRegion = document.getElementById('contenedorRegion');
        const contenedorEntidad = document.getElementById('contenedorEntidad');
        
        function configurarVistaCoordinadorAA() {
            // Verificar si NombreEntidadAcademica está vacío o solo contiene espacios
            const nombreEntidadAcademica = '@Model.NombreEntidadAcademica';
            
            if (!nombreEntidadAcademica || nombreEntidadAcademica.trim() === "") {
                if (contenedorEntidad) contenedorEntidad.style.display = "none";
                if (contenedorRegion) contenedorRegion.style.display = "none";
            }
        }
        
        // Ejecutar la función
        configurarVistaCoordinadorAA();
    });
</script>

