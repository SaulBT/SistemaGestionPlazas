@model UsuariosIndexViewModel

@{
    Layout = "_LayoutSuperUsuario";
    ViewData["Title"] = "Usuarios";
}

<form method="get" action="@Url.Action("Index", "Usuarios")">

    <!-- Filtros -->
    <div style="display:inline-flex; gap:10px; padding-bottom:30px;">
        @await Component.InvokeAsync("SelectField", new SelectFieldModel
        {
            Label = "Región",
            Options = Model.Regiones,
            Name = "region"
        })

        @await Component.InvokeAsync("SelectField", new SelectFieldModel
        {
            Label = "Área Académica",
            Options = Model.Areas,
            Name = "idAreaAcademica"
        })

        <div id="contenedorEntidad">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Label = "Entidad Académica",
                Options = Model.Entidades,
                Name = "idEntidadAcademica"
            })
        </div>
        
    </div>

    <!-- Acciones -->
    <div style="display:flex; gap:10px; padding-bottom:30px; align-items:center; justify-content:space-between">
        <!--Barra de Búsqueda-->
        @await Component.InvokeAsync("Buscador", new BuscadorModel
        {
            Name = "busqueda",
            Placeholder = "Buscar usuario...",
            Action = Url.Action("Index", "Usuarios"),
            Method = "get",
            Value = Context.Request.Query["busqueda"]
        })

        <!--Botón Crear Usuario-->
        <a href="@Url.Action("Create", ViewData["Title"])" style="display: inline-block; text-decoration: none;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Agregar",
                Texto = "Crear Usuario"
            })
        </a>
    
    </div>

</form>


<!-- Tabla con Datos -->
<div style="display:flex; gap:10px; padding-top:20px;justify-content:left" >
    @await Component.InvokeAsync("Table", Model.Table)
    
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.querySelector("form");

        const region = document.getElementById("region");
        const area = document.getElementById("idAreaAcademica");
        const entidad = document.getElementById("idEntidadAcademica");
        const contenedorEntidad = document.getElementById("contenedorEntidad");

        function toggleEntidad() {
            if (!area || !contenedorEntidad) return;

            if (!area.value) {
                contenedorEntidad.style.display = "none";
            } else {
                contenedorEntidad.style.display = "inline-flex";
            }
        }

        // Estado inicial
        toggleEntidad();

        // Región cambia
        if (region) {
            region.addEventListener("change", function () {
                if (area) area.value = "";
                if (entidad) entidad.value = "";
                form.submit();
            });
        }

        // Área cambia
        if (area) {
            area.addEventListener("change", function () {
                if (entidad) entidad.value = "";
                toggleEntidad();
                form.submit();
            });
        }

        // Entidad cambia
        if (entidad) {
            entidad.addEventListener("change", function () {
                form.submit();
            });
        }

    });
</script>