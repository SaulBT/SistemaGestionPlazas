@model List<SGPla.Models.DTOs.Usuarios.ListaUsuarioDTO>

@{
    Layout = "_LayoutSuperUsuario";
    ViewData["Title"] = "Usuarios";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Usuario</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Cargo</th>
            <th>Rol</th>
            <th>Entidad/Área</th>
            <th>Región</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Nombre</td>
                <td>@usuario.Correo</td>
                <td>@usuario.Cargo</td>
                <td>@usuario.Rol</td>
                <td>
                    @if (!string.IsNullOrEmpty(usuario.NombreEntidadAcademica))
                    {
                        @usuario.NombreEntidadAcademica
                    }
                    else if (!string.IsNullOrEmpty(usuario.NombreAreaAcademica))
                    {
                        @usuario.NombreAreaAcademica
                    }
                </td>
                <td>@usuario.Region</td>
                <td>
                    <a asp-action="Details" asp-route-id="@usuario.IdUsuario" asp-route-rol="@usuario.Rol" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@usuario.IdUsuario" asp-route-rol="@usuario.Rol" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@usuario.IdUsuario" asp-route-rol="@usuario.Rol" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>