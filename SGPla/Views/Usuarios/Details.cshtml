@model SGPla.Models.DTOs.Usuarios.DetallesUsuarioDTO

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h1>Detalles del Usuario</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Correo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Correo)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Cargo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Cargo)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Rol)
        </dt>
        <dd class="col-sm-10">
            @(Model.Rol == SGPla.Commons.Constantes.CoordinadorEa ? "Coordinador de Entidad Académica" : "Coordinador DGAA")
        </dd>

        @if (Model.Rol == SGPla.Commons.Constantes.CoordinadorEa)
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Region)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Region)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.NombreEntidadAcademica)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.NombreEntidadAcademica)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.NombreAreaAcademica)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.NombreAreaAcademica)
            </dd>
        }

        @if (Model.Rol == SGPla.Commons.Constantes.CoordinadorDgaa)
        {
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.NombreAreaAcademica)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.NombreAreaAcademica)
            </dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdUsuario" asp-route-rol="@Model?.Rol" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>