@using SGPla.Commons
@using SGPla.Models.ViewModels.Avisos
@model IndexViewModel

<div id="filtrosContainer" style="display: inline-flex; gap: 10px; padding-bottom: 20px; transition: all 0.3s ease;">
    @await Component.InvokeAsync("SelectField", new SelectFieldModel
        {
            Label = "Periodos",
            Options = Model.Periodos,
            Name = "idPeriodo"
        })
    @if (Model.Rol.Contains(Constantes.COORDINADOR_DGAA))
    {
        @await Component.InvokeAsync("SelectField", new SelectFieldModel
        {
            Label = "Entidad Académica:",
            Options = Model.Entidades,
            Name = "idEntidadAcademica",
            SelectedValue = "" + Model.IdEntidadSeleccionada
        })
    }
    @await Component.InvokeAsync("DatePicker", new DatePickerModel
        {
            Label = "Fecha Inicio",
            Name = "fechaInicio",
            Value = Model.FechaInicio?.ToString("yyyy-MM-dd")
        })
    @await Component.InvokeAsync("DatePicker", new DatePickerModel
        {
            Label = "Fecha Fin",
            Name = "fechaFin",
            Value = Model.FechaFin?.ToString("yyyy-MM-dd")
        })

</div>