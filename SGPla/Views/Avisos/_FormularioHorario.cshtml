@using SGPla.Models.ViewModels.Avisos
@model FormularioHorarioViewModel


@await Component.InvokeAsync("DatePicker", new DatePickerModel
    {
        Id = "Fecha",
        Label = "Fecha",
        Min = DateTime.Today.ToString("yyyy-MM-dd"),
        Flexible = true
    })

<button type="button" class="btn btn-outline-primary" onclick="aplicarHorarioSugerido()">
    Usar horario sugerido: 10:00–14:00 y 17:00–19:00
</button>

@await Component.InvokeAsync("TimeField", new TimeFieldModel
    {
        Id = "HoraInicio",
        Name = "HoraInicio",
        Label = "Hora de inicio",
        
    })

@await Component.InvokeAsync("TimeField", new TimeFieldModel
    {
        Id = "HoraTermino",
        Name = "HoraTermino",
        Label = "Hora de término"
    })



