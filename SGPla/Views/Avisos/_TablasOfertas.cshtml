@using SGPla.Models.ViewModels.Avisos
@model List<PlanEstudiosAvisoViewModel>

@if(Model.Count == 0)
{
    <div id="IdExistenOfertas" class="text-error-wrapper" style="margin-bottom:20px; margin-left:10px">No existen ofertas incluidas en el periodo y artículo seleccionados.</div>
}
else
{
    @foreach (var carrera in Model)
    {
        <div class="mb-4">

            <h5 style="margin-left:10px">@carrera.Nombre</h5>

            <div class="table-container">
                <table class="custom-table">
                    <thead>
                        <tr><th>Seleccionar</th><th>Horas</th><th>EE</th><th>NRC</th><th>Plaza</th><th>Horario</th><th>TC</th><th>Perfil docente</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var oferta in carrera.Ofertas)
                    {
                        <tr>
                            <td><input type="checkbox" name="OfertasId" value="@oferta.IdOferta" @(carrera.OfertasSeleccionadas.Contains(oferta.IdOferta) ? "checked" : null) /></td>
                            <td>@oferta.Horas</td><td>@oferta.ExperienciaEducativa</td><td>@oferta.NRC</td><td>@oferta.Plaza</td>
                            <td><button type="button" onclick='abrirModalHorario(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(oferta)))'>Ver</button></td>
                            <td>@oferta.TipoContratacion</td>
                            <td><button type="button" onclick='verPerfilDocenteOferta(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(oferta.PerfilDocente)))'>Ver</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

        </div>
    }
}
