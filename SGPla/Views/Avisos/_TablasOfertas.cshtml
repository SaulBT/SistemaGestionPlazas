@using SGPla.Models.ViewModels.Avisos
@model List<PlanEstudiosAvisoViewModel>

@if(Model.Count == 0)
{
    <div id="IdExistenOfertas" class="text-error-wrapper" style="margin-bottom:20px; margin-left:10px">No existen ofertas incluidas en el periodo y artículo seleccionados.</div>
}
else
{
    var ofertas = Model.SelectMany(plan => plan.Ofertas).ToList();
    var ofertasSeleccionadas = Model
        .SelectMany(plan => plan.OfertasSeleccionadas)
        .ToHashSet();
    var estanTodasSeleccionadas = ofertas.Count > 0 && ofertas.All(oferta => ofertasSeleccionadas.Contains(oferta.IdOferta));

    @foreach (var carrera in Model)
    {
        var esPrimeraTabla = carrera == Model[0];
        <div class="mb-4">

            <h5 style="margin-left:10px">@carrera.Nombre</h5>

            <div class="table-container">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>
                                @if (esPrimeraTabla)
                                {
                                    <input id="seleccionarTodasLasOfertas"
                                           type="checkbox"
                                           aria-label="Seleccionar todas las experiencias educativas"
                                           @(estanTodasSeleccionadas ? "checked" : null) />
                                }
                            </th>
                            <th>Horas</th><th>EE</th><th>NRC</th><th>Plaza</th><th>Horario</th><th>TC</th><th>Perfil docente</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var oferta in carrera.Ofertas)
                    {
                        <tr>
                            <td><input type="checkbox" name="OfertasId" value="@oferta.IdOferta" @(carrera.OfertasSeleccionadas.Contains(oferta.IdOferta) ? "checked" : null) /></td>
                            <td>@oferta.Horas</td><td>@oferta.ExperienciaEducativa</td><td>@oferta.NRC</td><td>@oferta.Plaza</td>
                            <td>
                                @await Component.InvokeAsync("Boton", new
                                {
                                    accion = "ver",
                                    fondo = false,
                                    onClick = $"abrirModalHorario({System.Text.Json.JsonSerializer.Serialize(oferta)})",
                                    ariaLabel = "Ver horario de la experiencia educativa"
                                })
                            </td>
                            <td>@oferta.TipoContratacion</td>
                            <td>
                                @await Component.InvokeAsync("Boton", new
                                {
                                    accion = "ver",
                                    fondo = false,
                                    onClick = $"verPerfilDocenteOferta({System.Text.Json.JsonSerializer.Serialize(oferta.PerfilDocente)})",
                                    ariaLabel = "Ver perfil docente de la experiencia educativa"
                                })
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

        </div>
    }
}
