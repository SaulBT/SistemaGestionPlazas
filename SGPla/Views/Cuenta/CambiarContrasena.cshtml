@model SGPla.Models.ViewModels.Login.CambiarContrasenaSuperusuarioViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = "_LayoutSuperUsuario";
}

<main class="container py-4">
    <h1>Cambio de contraseña obligatorio</h1>
    <p>Actualice la contraseña de la cuenta antes de continuar.</p>

    <form asp-controller="Cuenta" asp-action="CambiarContrasena" method="post" class="formulario-con-barra-acciones">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="ContrasenaActual" class="form-label">Contraseña actual</label>
            <input asp-for="ContrasenaActual" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="ContrasenaActual" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ContrasenaNueva" class="form-label">Contraseña nueva</label>
            <input asp-for="ContrasenaNueva" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ContrasenaNueva" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmarContrasena" class="form-label">Confirmar contraseña nueva</label>
            <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
