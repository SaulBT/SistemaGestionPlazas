@using SGPla.Models.ViewModels.Catalogos
@model RegionCampusAdminViewModel
@{ ViewData["Title"] = "Administrar Regiones y Campus"; }
<div class="container py-3">
    <p><a asp-controller="Catalogos" asp-action="Index">← Catálogos</a></p>
    <h1>Regiones y Campus</h1>
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="row g-4">
        <section class="col-lg-5" aria-labelledby="regiones-titulo">
            <h2 id="regiones-titulo" class="h4">Regiones</h2>
            <form asp-action="CrearRegion" method="post" class="card card-body mb-3">
                @Html.AntiForgeryToken()
                <label for="region-clave" class="form-label">Clave</label><input id="region-clave" name="Clave" type="number" min="1" class="form-control" required />
                <label for="region-nombre" class="form-label mt-2">Nombre</label><input id="region-nombre" name="Nombre" maxlength="200" class="form-control" required />
                <button class="btn btn-primary mt-3">Agregar región</button>
            </form>
            <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Clave</th><th>Nombre</th><th>Acciones</th></tr></thead><tbody>
                @foreach (var item in Model.Regiones) { <tr><td>@item.Clave</td><td><form asp-action="EditarNombreRegion" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@item.Id" /><label class="visually-hidden" for="region-@item.Id">Nombre de @item.Nombre</label><input id="region-@item.Id" name="Nombre" value="@item.Nombre" maxlength="200" class="form-control form-control-sm" required /><button class="btn btn-sm btn-outline-primary">Guardar</button></form></td><td><form asp-action="EliminarRegion" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Baja lógica</button></form></td></tr> }
            </tbody></table></div>
        </section>
        <section class="col-lg-7" aria-labelledby="campus-titulo">
            <h2 id="campus-titulo" class="h4">Campus</h2>
            <form asp-action="CrearCampus" method="post" class="card card-body mb-3">
                @Html.AntiForgeryToken()
                <div class="row g-2"><div class="col-md-3"><label for="campus-clave" class="form-label">Clave</label><input id="campus-clave" name="Clave" maxlength="50" pattern="[A-Za-z0-9]+" class="form-control" required /></div>
                    <div class="col-md-4"><label for="campus-nombre" class="form-label">Nombre</label><input id="campus-nombre" name="Nombre" maxlength="200" class="form-control" required /></div>
                    <div class="col-md-3"><label for="campus-region" class="form-label">Región</label><select id="campus-region" name="RegionId" class="form-select" required><option value="">Selecciona</option>@foreach (var item in Model.Regiones) { <option value="@item.Id">@item.Nombre</option> }</select></div>
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Agregar</button></div></div>
            </form>
            <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Clave</th><th>Nombre</th><th>Región</th><th>Acciones</th></tr></thead><tbody>
                @foreach (var item in Model.Campus) { <tr><td>@item.Clave</td><td><form asp-action="EditarNombreCampus" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@item.Id" /><label class="visually-hidden" for="campus-@item.Id">Nombre de @item.Nombre</label><input id="campus-@item.Id" name="Nombre" value="@item.Nombre" maxlength="200" class="form-control form-control-sm" required /><button class="btn btn-sm btn-outline-primary">Guardar</button></form></td><td>@item.Region</td><td><form asp-action="EliminarCampus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Baja lógica</button></form></td></tr> }
            </tbody></table></div>
            <p class="form-text">Las claves institucionales y la región del Campus son inmutables. Las bajas se bloquean si existen dependencias vigentes.</p>
        </section>
    </div>
</div>
