@using SGPla.Models.ViewModels.Solicitudes
@model SolicitudMvcDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Solicitud";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2>Solicitud #@Model.Id</h2><p class="text-muted mb-0">Estado: @Model.Estado · registrada en UTC @Model.RegistradaEn.ToString("yyyy-MM-dd HH:mm")</p></div>
    <a asp-action="Index" asp-route-avisoId="@Model.AvisoId" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<section class="card mb-4">
    <div class="card-header">Perfil congelado para esta Solicitud</div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
            <dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@Model.Correo</dd>
            <dt class="col-sm-3">Puesto actual</dt><dd class="col-sm-9">@(Model.PuestoActual ?? "—")</dd>
            <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@Model.DescripcionPerfil</dd>
            <dt class="col-sm-3">Observaciones</dt><dd class="col-sm-9">@(Model.Observaciones ?? "—")</dd>
        </dl>
        <h5>Formación</h5>
        <ul>@foreach (var formacion in Model.FormacionesCapturadas) { <li><strong>@formacion.Grado:</strong> @formacion.Descripcion</li> }</ul>
        <h5>Documentos de esta Solicitud</h5>
        @if (Model.Documentos.Count == 0)
        {
            <p class="text-muted">No hay documentos adjuntos.</p>
        }
        else
        {
            <ul>
            @foreach (var documento in Model.Documentos)
            {
                <li>@documento.TipoDocumento · @documento.Nombre · versión @documento.NumeroVersion
                    <a asp-action="DescargarDocumento" asp-route-avisoId="@Model.AvisoId" asp-route-solicitudId="@Model.Id" asp-route-versionDocumentoId="@documento.VersionId">Descargar</a>
                </li>
            }
            </ul>
        }
        @if (Model.Estado == "REGISTRADA")
        {
            <form asp-action="AgregarDocumento" asp-route-avisoId="@Model.AvisoId" asp-route-solicitudId="@Model.Id" method="post" enctype="multipart/form-data" class="row g-2 align-items-end mb-4">
                @Html.AntiForgeryToken()
                <div class="col-md-4"><label class="form-label" for="tipoDocumentoId">Tipo de documento</label><select id="tipoDocumentoId" name="tipoDocumentoId" class="form-select" required><option value="">Seleccione</option>@foreach (var tipo in Model.TiposDocumento) { <option value="@tipo.Id">@tipo.Nombre</option> }</select></div>
                <div class="col-md-3"><label class="form-label" for="documentoAspiranteId">Documento existente (opcional)</label><select id="documentoAspiranteId" name="documentoAspiranteId" class="form-select"><option value="">Crear nuevo</option>@foreach (var documento in Model.Documentos.GroupBy(x => x.DocumentoAspiranteId).Select(x => x.OrderByDescending(y => y.NumeroVersion).First())) { <option value="@documento.DocumentoAspiranteId" data-tipo="@documento.TipoDocumentoId">@documento.TipoDocumento · @documento.Nombre (v@documento.NumeroVersion)</option> }</select></div>
                <div class="col-md-3"><label class="form-label" for="archivo">PDF (máximo 25 MB)</label><input id="archivo" name="archivo" class="form-control" type="file" accept="application/pdf,.pdf" required /></div>
                <div class="col-md-2"><button class="btn btn-outline-primary" type="submit">Adjuntar</button></div>
            </form>
            <details>
                <summary class="btn btn-sm btn-outline-primary">Crear nueva versión del perfil</summary>
                <form asp-action="ActualizarPerfil" asp-route-avisoId="@Model.AvisoId" asp-route-solicitudId="@Model.Id" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-md-6"><label class="form-label">Nombre</label><input name="Nombre" value="@Model.Nombre" class="form-control" maxlength="200" required /></div>
                        <div class="col-md-6"><label class="form-label">Correo</label><input name="Correo" value="@Model.Correo" class="form-control" type="email" maxlength="254" required /></div>
                        <div class="col-md-6"><label class="form-label">Puesto actual</label><input name="PuestoActual" value="@Model.PuestoActual" class="form-control" maxlength="200" /></div>
                        <div class="col-12"><label class="form-label">Descripción del perfil</label><textarea name="DescripcionPerfil" class="form-control" maxlength="10000" required>@Model.DescripcionPerfil</textarea></div>
                    </div>
                    <h5 class="mt-3">Formaciones</h5>
                    @for (var i = 0; i < Model.Formaciones.Count; i++)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-md-4"><select name="Formaciones[@i].GradoAcademicoId" class="form-select" required><option value="">Seleccione</option>@foreach (var grado in Model.GradosAcademicos) { <option value="@grado.Id" selected="@(grado.Id == Model.Formaciones[i].GradoAcademicoId)">@grado.Nombre</option> }</select></div>
                            <div class="col-md-8"><input name="Formaciones[@i].Descripcion" value="@Model.Formaciones[i].Descripcion" class="form-control" maxlength="500" required /></div>
                        </div>
                    }
                    <button class="btn btn-primary mt-2" type="submit">Guardar nueva versión</button>
                </form>
            </details>
        }
    </div>
</section>

@if (Model.Estado == "REGISTRADA")
{
    <section class="card mb-3">
        <div class="card-header">Resolver Solicitud</div>
        <div class="card-body d-flex flex-wrap gap-3">
            <form asp-action="Resolver" asp-route-avisoId="@Model.AvisoId" asp-route-solicitudId="@Model.Id" method="post">
                @Html.AntiForgeryToken()<input type="hidden" name="admitir" value="true" />
                <button class="btn btn-success" type="submit">Admitir</button>
            </form>
            <form asp-action="Resolver" asp-route-avisoId="@Model.AvisoId" asp-route-solicitudId="@Model.Id" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()<input type="hidden" name="admitir" value="false" />
                <input class="form-control" name="motivoNoAdmision" maxlength="1000" placeholder="Motivo obligatorio" required />
                <button class="btn btn-outline-danger" type="submit">No admitir</button>
            </form>
        </div>
    </section>
}

<script>
    document.getElementById('documentoAspiranteId')?.addEventListener('change', event => {
        const opcion = event.target.selectedOptions[0];
        if (opcion?.dataset.tipo) document.getElementById('tipoDocumentoId').value = opcion.dataset.tipo;
    });
</script>
else if (Model.Estado == "ADMITIDA")
{
    <form asp-action="Retirar" asp-route-avisoId="@Model.AvisoId" asp-route-solicitudId="@Model.Id" method="post" class="card card-body">
        @Html.AntiForgeryToken()
        <label class="form-label" for="motivo">Motivo de retiro (opcional)</label>
        <div class="d-flex gap-2"><input id="motivo" name="motivo" class="form-control" maxlength="1000" /><button class="btn btn-outline-danger" type="submit">Retirar antes de la sesión</button></div>
    </form>
}
