@using SGPla.Models.Components
@using SGPla.Models.ViewModels.SincronizacionPlanea
@model CopiasViewModel
@{ ViewData["Title"] = "Copias registradas"; }
<div class="contenido-tabla">
    <div class="d-flex gap-3 mb-3">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Bitácora</a>
        <a class="btn btn-outline-primary" href="@Url.Action("Copias")">Copias registradas</a>
    </div>
    <form id="filtrosForm" method="get" action="@Url.Action("Copias")" class="d-flex gap-3 align-items-end mb-3 flex-wrap">
        @await Component.InvokeAsync("SelectField", new SelectFieldModel { Id="periodoFiltro", Name="idPeriodo", Label="Periodo", SelectedValue=Model.IdPeriodo?.ToString(), Options=Model.Periodos, HtmlAttributes=new Dictionary<string,string>{{"data-autosubmit","true"}} })
        @await Component.InvokeAsync("SelectField", new SelectFieldModel { Id="planFiltro", Name="idPlanEstudios", Label="Plan", SelectedValue=Model.IdPlanEstudios?.ToString(), Options=Model.Planes, HtmlAttributes=new Dictionary<string,string>{{"data-autosubmit","true"}} })
        @await Component.InvokeAsync("SelectField", new SelectFieldModel { Id="regionFiltro", Name="idRegion", Label="Región", SelectedValue=Model.IdRegion?.ToString(), Options=Model.Regiones, HtmlAttributes=new Dictionary<string,string>{{"data-autosubmit","true"}} })
        @await Component.InvokeAsync("Buscador", new BuscadorModel { Name="busqueda", Value=Model.Busqueda ?? "", Placeholder="Buscar NRC o experiencia educativa...", ButtonText="Buscar" })
        <input type="hidden" name="pagina" id="paginaHidden" value="@Model.PaginaActual" />
        <input type="hidden" name="cantidad" id="cantidadHidden" value="@Model.CantidadPorPagina" />
    </form>
    @await Component.InvokeAsync("Table", Model.Table)
</div>
<script>
document.querySelectorAll("#filtrosForm select").forEach(x => x.addEventListener("change", () => document.getElementById("paginaHidden").value = "1"));
document.querySelector("#filtrosForm input[name='busqueda']")?.addEventListener("change", () => document.getElementById("paginaHidden").value = "1");
</script>
