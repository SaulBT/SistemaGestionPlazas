@using SGPla.Models.ViewModels.SincronizacionPlanea
@model DetalleCopiaViewModel
@{ ViewData["Title"] = $"NRC {Model.Detalle.Copia.Nrc}"; var d = Model.Detalle; }
<div class="contenido-pagina">
    <h2>NRC @d.Copia.Nrc — periodo @d.Copia.CodigoPeriodo</h2>
    <dl class="row">
        <dt class="col-sm-3">Experiencia Educativa</dt><dd class="col-sm-9">@d.Copia.CodigoExperiencia — @d.Copia.NombreExperiencia</dd>
        <dt class="col-sm-3">Plan</dt><dd class="col-sm-9">@(d.Copia.CodigoPlan ?? "—") — @d.NombrePlan</dd>
        <dt class="col-sm-3">Título en PLANEA</dt><dd class="col-sm-9">@d.TituloPlanea</dd>
        <dt class="col-sm-3">Región / Campus</dt><dd class="col-sm-9">@(d.Copia.Region ?? "—") / @(d.Copia.Campus ?? "—")</dd>
        <dt class="col-sm-3">Nivel / Área</dt><dd class="col-sm-9">@(d.Nivel ?? "—") / @(d.Area ?? "—")</dd>
        <dt class="col-sm-3">Ejecución que registró</dt><dd class="col-sm-9">@d.IdSincronizacionPlanea</dd>
    </dl>
    <h3>Horarios (@d.Horarios.Count)</h3>
    @await Component.InvokeAsync("Table", Model.TablaHorarios)
    <a class="btn btn-secondary mt-3" href="@Model.UrlVolver">Volver al listado</a>
</div>
