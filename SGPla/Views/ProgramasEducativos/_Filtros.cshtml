@model SGPla.Models.ViewModels.ProgramasEducativos.IndexViewModel
<div id="filtrosContainer" class="d-flex gap-2 pb-3">
    <select name="regionId" id="regionId" class="form-select"><option value="">Todas las regiones</option>@foreach (var item in Model.Regiones) { <option value="@item.Value" selected="@item.Selected">@item.Text</option> }</select>
    <select name="idAreaAcademica" id="idAreaAcademica" class="form-select"><option value="">Todas las áreas</option>@foreach (var item in Model.Areas) { <option value="@item.Value" selected="@item.Selected">@item.Text</option> }</select>
    <select name="idEntidadAcademica" id="idEntidadAcademica" class="form-select"><option value="">Todas las entidades</option>@foreach (var item in Model.Entidades) { <option value="@item.Value" selected="@item.Selected">@item.Text</option> }</select>
</div>
