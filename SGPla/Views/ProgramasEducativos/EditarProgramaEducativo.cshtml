@using SGPla.Models.ViewModels.ProgramasEducativos

@model CrearProgramaEducativoViewModel

@{
    ViewData["Title"] = "Editar Programa Educativo";
}

<!-- Campos -->
<form method="post" action="@Url.Action("EditarProgramaEducativo", "ProgramasEducativos")">

    @Html.AntiForgeryToken()
    <input type="hidden" name="IdProgramaEducativo" value="@Model.IdProgramaEducativo" />

    <div style="padding-bottom:var(--padding-end); ">
        <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:center; justify-content:space-between;">
            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Id = "nombre",
                Name = "Nombre",
                Label = "Nombre:",
                Valor = Model.Nombre,
                Flexible = true,
                Error = ViewData.ModelState["Nombre"]?.Errors.FirstOrDefault()?.ErrorMessage,
                MaximoCaracteres = 100
            })
        </div>

        <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">

            <div id="contenedoCampus" style="flex:1 1 0; min-width:0;">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "campus",
                    Name = "Campus",
                    Label = "Campus:",
                    Valor = Model.Campus,
                    Flexible = true,
                    Error = ViewData.ModelState["Campus"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 100
                })
            </div>

            <div id="contenedorRegion" style="flex:1 1 0; min-width:0;">
                @await Component.InvokeAsync("SelectField", new SelectFieldModel
                {
                    Label = "Región",
                    Options = Model.Regiones,
                    Name = "Region",
                    SelectedValue = Model.Region?.ToString(),
                    Flexible = true,
                    Error = ViewData.ModelState["Region"]?.Errors.FirstOrDefault()?.ErrorMessage
                })
            </div>

        </div>

        <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly; width:100%;">
            <div id="contenedorArea" style="flex:1 1 0; min-width:0;">
                @await Component.InvokeAsync("SelectField", new SelectFieldModel
                {
                    Label = "Área Académica",
                    Options = Model.Areas,
                    Name = "IdAreaAcademica",
                    SelectedValue = Model.IdAreaAcademica?.ToString(),
                    Flexible = true,
                    Error = ViewData.ModelState["IdAreaAcademica"]?.Errors.FirstOrDefault()?.ErrorMessage
                    
                })
            </div>

           

            <div id="contenedorEntidad" style="flex:1 1 0; min-width:0;">
                @await Component.InvokeAsync("SelectField", new SelectFieldModel
                {
                    Label = "Entidad Académica",
                    Options = Model.Entidades,
                    Name = "IdEntidadAcademica",
                    SelectedValue = Model.IdEntidadAcademica.ToString(),
                    Flexible = true,
                    Error = ViewData.ModelState["IdEntidadAcademica"]?.Errors.FirstOrDefault()?.ErrorMessage
                })
            </div>
        </div>
    </div>

    <!-- Botones -->
    <div style="display:flex; justify-content:flex-end; gap:var(--button-gap)">
        <a href="@Url.Action("Index", "ProgramasEducativos")" style="display: inline-block; text-decoration: none;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Cancelar"
            })
        </a>
        @await Component.InvokeAsync("Boton", new
        {
            Accion = "Guardar",
            ButtonType = "submit"
        })
    </div>
</form>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const area = document.querySelector("[name='IdAreaAcademica']");
        const region = document.querySelector("[name='Region']");
        const entidad = document.querySelector("[name='IdEntidadAcademica']");

            async function cargarEntidades() {
        if (!area || !region || !entidad) return;

        const idArea = area.value;
        const reg = region.value;

        // mantener opción default
        const defaultOption = entidad.options[0];

        if (!idArea || !reg) {
            entidad.innerHTML = "";
            entidad.appendChild(defaultOption);
            entidad.selectedIndex = 0;
            return;
        }

        try {
            const response = await fetch(`/ProgramasEducativos/ObtenerEntidades?region=${encodeURIComponent(reg)}&idArea=${idArea}`);
            const data = await response.json();

            entidad.innerHTML = "";
            entidad.appendChild(defaultOption);

            data.forEach(e => {
                const option = document.createElement("option");
                option.value = e.value;
                option.text = e.text;
                entidad.appendChild(option);
            });

        } catch (error) {
            console.error("Error cargando entidades:", error);
        }
    }

        if (area) {
            area.addEventListener("change", cargarEntidades);
        }

        if (region) {
            region.addEventListener("change", cargarEntidades);
        }

    });
</script>