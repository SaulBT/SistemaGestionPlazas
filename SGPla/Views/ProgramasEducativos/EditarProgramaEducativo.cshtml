@model SGPla.Models.ViewModels.ProgramasEducativos.CrearProgramaEducativoViewModel
@{ ViewData["Title"] = "Editar Programa Educativo"; }
<form asp-action="EditarProgramaEducativo" method="post" class="formulario-con-barra-acciones">
    @Html.AntiForgeryToken()
    <input asp-for="IdProgramaEducativo" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 p-3">
        <div class="col-md-6"><label asp-for="Nombre" class="form-label">Nombre del programa</label><input asp-for="Nombre" class="form-control" maxlength="200"/><span asp-validation-for="Nombre" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="IdEntidadAcademica" class="form-label">Entidad académica</label><select asp-for="IdEntidadAcademica" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Entidades, "Value", "Text", Model.IdEntidadAcademica))" class="form-select"><option value="">Seleccione una entidad</option></select><span asp-validation-for="IdEntidadAcademica" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="IdSistemaEducativo" class="form-label">Sistema educativo</label><select asp-for="IdSistemaEducativo" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.SistemasEducativos, "Value", "Text", Model.IdSistemaEducativo))" class="form-select"><option value="">Seleccione un sistema</option></select><span asp-validation-for="IdSistemaEducativo" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="IdNivelFormacion" class="form-label">Nivel de formación</label><select asp-for="IdNivelFormacion" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.NivelesFormacion, "Value", "Text", Model.IdNivelFormacion))" class="form-select"><option value="">Seleccione un nivel</option></select><span asp-validation-for="IdNivelFormacion" class="text-danger"></span></div>
    </div>
    <div class="barra-acciones-fija"><a asp-action="Index">Cancelar</a><button class="btn btn-primary" type="submit">Guardar cambios</button></div>
</form>
<partial name="_ValidationScriptsPartial" />
