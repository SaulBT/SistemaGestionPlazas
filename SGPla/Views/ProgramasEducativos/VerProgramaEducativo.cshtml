@model SGPla.Models.DTOs.ProgramaEducativo.ProgramaEducativoMvcDto
@{ ViewData["Title"] = "Ver Programa Educativo"; }
<dl class="row p-3">
    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Entidad académica</dt><dd class="col-sm-9">@Model.EntidadAcademica</dd>
    <dt class="col-sm-3">Área académica</dt><dd class="col-sm-9">@Model.AreaAcademica</dd>
    <dt class="col-sm-3">Campus</dt><dd class="col-sm-9">@Model.Campus</dd>
    <dt class="col-sm-3">Región</dt><dd class="col-sm-9">@Model.Region</dd>
    <dt class="col-sm-3">Sistema educativo</dt><dd class="col-sm-9">@Model.SistemaEducativo</dd>
    <dt class="col-sm-3">Nivel de formación</dt><dd class="col-sm-9">@Model.NivelFormacion</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Regresar</a>
