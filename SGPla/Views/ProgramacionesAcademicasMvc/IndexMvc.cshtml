@using SGPla.Models.ViewModels.ProgramacionesAcademicas
@using SGPla.Commons
@model ProgramacionAcademicaMvcIndexViewModel
@{ ViewData["Title"] = "Programación Académica"; var paginas = (int)Math.Ceiling(Model.Total / (double)Model.Filtro.TamanoPagina); }
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center"><h1>Programación Académica</h1>@if (User.IsInRole(Constantes.COORDINADOR_DGAA)) { <a href="/ProgramacionesAcademicas/Importar" class="btn btn-primary">Importar Vacantes y Descargas</a> }</div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (User.IsInRole(Constantes.COORDINADOR_DGAA))
    {
        <form method="post" action="/ProgramacionesAcademicas/SincronizarPlanea" class="d-flex gap-2 align-items-end mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="periodoEscolarIdSincronizacion" name="periodoEscolarId" value="@Model.Filtro.PeriodoEscolarId" />
            <button id="botonSincronizarPlanea" class="btn btn-outline-primary" type="submit" disabled="@(Model.Filtro.PeriodoEscolarId is null)">Sincronizar PLANEA</button>
            <span id="ayudaSincronizarPlanea" class="form-text" hidden="@(Model.Filtro.PeriodoEscolarId is not null)">Selecciona un periodo para habilitar la sincronización.</span>
        </form>
    }
    <form method="get" action="/ProgramacionesAcademicas" class="card card-body mb-3">
        <div class="row g-2">
            @if (!User.IsInRole(Constantes.COORDINADOR_EA)) {
            <div class="col-md-3"><label class="form-label" for="RegionId">Región</label><select class="form-select" id="RegionId" name="RegionId"><option value="">Todas</option>@foreach (var item in Model.Regiones) { <option value="@item.Id" selected="@(Model.Filtro.RegionId == item.Id)">@item.Nombre</option> }</select></div>
            <div class="col-md-3"><label class="form-label" for="EntidadAcademicaId">Entidad Académica</label><select class="form-select" id="EntidadAcademicaId" name="EntidadAcademicaId"><option value="">Todas</option>@foreach (var item in Model.Entidades) { <option value="@item.Id" selected="@(Model.Filtro.EntidadAcademicaId == item.Id)">@item.Nombre</option> }</select></div>
            } else { <input type="hidden" name="EntidadAcademicaId" value="@Model.Items.FirstOrDefault()?.EntidadAcademicaId" /> }
            <div class="col-md-3"><label class="form-label" for="ProgramaEducativoId">Programa</label><select class="form-select" id="ProgramaEducativoId" name="ProgramaEducativoId"><option value="">Todos</option>@foreach (var item in Model.Programas) { <option value="@item.Id" selected="@(Model.Filtro.ProgramaEducativoId == item.Id)">@item.Nombre</option> }</select></div>
            <div class="col-md-3"><label class="form-label" for="PeriodoEscolarId">Periodo</label><select class="form-select" id="PeriodoEscolarId" name="PeriodoEscolarId"><option value="">Todos</option>@foreach (var item in Model.Periodos) { <option value="@item.Id" selected="@(Model.Filtro.PeriodoEscolarId == item.Id)">@item.Nombre</option> }</select></div>
            <div class="col-md-9"><label class="form-label" for="Busqueda">NRC o Experiencia Educativa</label><input id="Busqueda" name="Busqueda" value="@Model.Filtro.Busqueda" class="form-control" /></div>
            <div class="col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Filtrar</button></div>
        </div>
    </form>
    <p>@Model.Total programación(es)</p>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Periodo</th><th>Entidad Académica</th><th>Programa</th><th>NRC</th><th>Experiencia Educativa</th><th>Materia</th><th>Curso</th>@if (User.IsInRole(Constantes.COORDINADOR_EA)) { <th>Acciones</th> }</tr></thead><tbody>
        @foreach (var item in Model.Items) { <tr><td>@item.Periodo</td><td>@item.EntidadAcademica</td><td>@item.ProgramaEducativo</td><td>@item.Nrc</td><td>@item.ExperienciaEducativa</td><td>@item.MateriaEe</td><td>@item.CursoEe</td>@if (User.IsInRole(Constantes.COORDINADOR_EA)) { <td><a class="btn btn-sm btn-outline-primary" href="/ProgramacionesAcademicas/@item.Id/Ofertas/Nueva">Crear Oferta</a></td> }</tr> }
    </tbody></table></div>
    @if (paginas > 1) { <nav aria-label="Paginación"><ul class="pagination">@for (var p = 1; p <= paginas; p++) { <li class="page-item @(p == Model.Filtro.Pagina ? "active" : "")"><a class="page-link" href="?Pagina=@p&TamanoPagina=@Model.Filtro.TamanoPagina&RegionId=@Model.Filtro.RegionId&EntidadAcademicaId=@Model.Filtro.EntidadAcademicaId&ProgramaEducativoId=@Model.Filtro.ProgramaEducativoId&PeriodoEscolarId=@Model.Filtro.PeriodoEscolarId&Busqueda=@Model.Filtro.Busqueda">@p</a></li> }</ul></nav> }
    <p class="form-text">Esta página consulta programación, Experiencias Educativas y periodos del modelo normalizado. Los horarios y docentes dependen de la sincronización PLANEA.</p>
</div>

<script>
    (() => {
        const selectorPeriodo = document.getElementById("PeriodoEscolarId");
        const periodoSincronizacion = document.getElementById("periodoEscolarIdSincronizacion");
        const botonSincronizar = document.getElementById("botonSincronizarPlanea");
        const ayudaSincronizar = document.getElementById("ayudaSincronizarPlanea");
        if (!selectorPeriodo || !periodoSincronizacion || !botonSincronizar) return;

        const actualizarPeriodoSincronizacion = () => {
            periodoSincronizacion.value = selectorPeriodo.value;
            botonSincronizar.disabled = selectorPeriodo.value === "";
            if (ayudaSincronizar) ayudaSincronizar.hidden = selectorPeriodo.value !== "";
        };

        selectorPeriodo.addEventListener("change", actualizarPeriodoSincronizacion);
        actualizarPeriodoSincronizacion();
    })();
</script>
