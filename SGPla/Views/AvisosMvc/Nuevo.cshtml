@model SGPla.Models.ViewModels.Avisos.CrearAvisoMvcViewModel
@{
    ViewData["Title"] = "Crear Aviso";
}

<div class="container py-4">
    <h1 class="h3">Crear borrador de Aviso</h1>
    <p class="text-muted">Todas las selecciones se validan de nuevo en el servidor. Al crear el Aviso, las Ofertas pasan a EN_PUBLICACION dentro de la misma transacción.</p>
    <form method="get" asp-action="Nuevo" class="row g-3 mb-4" aria-label="Filtrar Ofertas disponibles">
        <div class="col-md-4">
            <label class="form-label" for="periodoFiltro">Periodo escolar</label>
            <select class="form-select" id="periodoFiltro" name="periodoEscolarId" required>
                <option value="">Selecciona un periodo</option>
                @foreach (var option in Model.Datos.Periodos)
                {
                    <option value="@option.Id" selected="@(Model.PeriodoEscolarId == option.Id)">@option.Texto</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="sistemaFiltro">Sistema educativo</label>
            <select class="form-select" id="sistemaFiltro" name="sistemaEducativoId" required>
                <option value="">Selecciona un sistema</option>
                @foreach (var option in Model.Datos.SistemasEducativos)
                {
                    <option value="@option.Id" selected="@(Model.SistemaEducativoId == option.Id)">@option.Texto</option>
                }
            </select>
        </div>
        <div class="col-md-4 align-self-end"><button class="btn btn-outline-primary" type="submit">Buscar Ofertas</button></div>
    </form>

    @if (Model.PeriodoEscolarId > 0 && Model.SistemaEducativoId > 0)
    {
        <form method="post" asp-action="Nuevo">
            <input type="hidden" asp-for="PeriodoEscolarId" />
            <input type="hidden" asp-for="SistemaEducativoId" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="ArticuloId">Artículo</label>
                    <select class="form-select" asp-for="ArticuloId" required>
                        <option value="">Selecciona artículo</option>
                        @foreach (var option in Model.Datos.Articulos)
                        {
                            <option value="@option.Id" selected="@(Model.ArticuloId == option.Id)">@option.Texto</option>
                        }
                    </select>
                    <span asp-validation-for="ArticuloId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="TipoComunicado">Tipo de comunicado</label>
                    <select class="form-select" asp-for="TipoComunicado">
                        <option value="AVISO">Aviso</option>
                        <option value="CONVOCATORIA">Convocatoria</option>
                    </select>
                </div>
                <fieldset class="col-12">
                    <legend class="h6">Ofertas disponibles para el periodo y sistema</legend>
                    @if (Model.Datos.OfertasDisponibles.Count == 0)
                    {
                        <p class="text-muted">No hay Ofertas disponibles para esta selección.</p>
                    }
                    @foreach (var option in Model.Datos.OfertasDisponibles)
                    {
                        var checkedValue = Model.OfertaIds.Contains(option.Id);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="OfertaIds" value="@option.Id" id="oferta-@option.Id" checked="@checkedValue" />
                            <label class="form-check-label" for="oferta-@option.Id">@option.Texto</label>
                        </div>
                    }
                    <span asp-validation-for="OfertaIds" class="text-danger"></span>
                </fieldset>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit" disabled="@(Model.Datos.OfertasDisponibles.Count == 0)">Crear borrador</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                </div>
            </div>
        </form>
    }
</div>
