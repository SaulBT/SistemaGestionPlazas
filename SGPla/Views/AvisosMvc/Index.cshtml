@model SGPla.Models.ViewModels.Avisos.AvisosMvcIndexViewModel
@{
    ViewData["Title"] = "Avisos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Avisos</h1>
        @if (User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_EA))
        {
            <a class="btn btn-primary" asp-controller="AvisosMvc" asp-action="Nuevo">Crear Aviso</a>
        }
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    <p class="text-muted">El flujo normalizado permite crear borradores con Ofertas vigentes. La revisión, firma y publicación se habilitarán al completar sus transiciones.</p>

    <form method="get" asp-controller="AvisosMvc" asp-action="Index" class="row g-2 mb-3">
        <div class="col-auto">
            <label class="form-label" for="periodoEscolarId">Periodo</label>
            <select class="form-select" id="periodoEscolarId" name="periodoEscolarId">
                <option value="">Todos</option>
                @foreach (var periodo in Model.Periodos)
                {
                    <option value="@periodo.Id" selected="@(Model.PeriodoEscolarId == periodo.Id)">@periodo.Texto</option>
                }
            </select>
        </div>
        @if (User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_DGAA))
        {
            <div class="col-auto">
                <label class="form-label" for="entidadAcademicaId">Entidad Académica</label>
                <select class="form-select" id="entidadAcademicaId" name="entidadAcademicaId">
                    <option value="">Todas las de mi Área</option>
                    @foreach (var entidad in Model.Entidades)
                    {
                        <option value="@entidad.Id" selected="@(Model.EntidadAcademicaId == entidad.Id)">@entidad.Texto</option>
                    }
                </select>
            </div>
        }
        <div class="col-auto">
            <label class="form-label" for="estado">Estado</label>
            <select class="form-select" id="estado" name="estado">
                <option value="">Todos</option>
                <option value="CREADO" selected="@(Model.Estado == "CREADO")">CREADO</option>
                <option value="EN_REVISION_DGAA" selected="@(Model.Estado == "EN_REVISION_DGAA")">EN_REVISION_DGAA</option>
                <option value="DEVUELTO_DGAA" selected="@(Model.Estado == "DEVUELTO_DGAA")">DEVUELTO_DGAA</option>
                <option value="AVALADO_DGAA" selected="@(Model.Estado == "AVALADO_DGAA")">AVALADO_DGAA</option>
                <option value="FIRMADO" selected="@(Model.Estado == "FIRMADO")">FIRMADO</option>
                <option value="PUBLICADO" selected="@(Model.Estado == "PUBLICADO")">PUBLICADO</option>
                <option value="CANCELADO" selected="@(Model.Estado == "CANCELADO")">CANCELADO</option>
            </select>
        </div>
        <div class="col-auto align-self-end"><button class="btn btn-outline-primary" type="submit">Filtrar</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption class="visually-hidden">Avisos dentro del ámbito autorizado</caption>
            <thead><tr><th>ID</th><th>Entidad</th><th>Periodo</th><th>Sistema</th><th>Artículo</th><th>Tipo</th><th>Estado</th><th>Ofertas</th><th>Creado UTC</th></tr></thead>
            <tbody>
            @foreach (var aviso in Model.Avisos)
            {
                <tr>
                    <td><a asp-controller="AvisosMvc" asp-action="Detalle" asp-route-avisoId="@aviso.Id">@aviso.Id</a></td><td>@aviso.EntidadAcademica</td><td>@aviso.PeriodoEscolar</td>
                    <td>@aviso.SistemaEducativo</td><td>@aviso.Articulo</td><td>@aviso.TipoComunicado</td>
                    <td>@aviso.Estado</td><td>@aviso.Ofertas</td><td><time datetime="@aviso.CreadoEn.ToString("O")">@aviso.CreadoEn.ToString("u")</time></td>
                </tr>
            }
            @if (Model.Avisos.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No hay Avisos para estos filtros.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="d-flex align-items-center gap-3" aria-live="polite">
        <span>@Model.Total registro(s)</span>
        @if (Model.Pagina > 1)
        {
            <a asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" asp-route-tamanoPagina="@Model.TamanoPagina" asp-route-periodoEscolarId="@Model.PeriodoEscolarId" asp-route-entidadAcademicaId="@Model.EntidadAcademicaId" asp-route-estado="@Model.Estado">Anterior</a>
        }
        @if (Model.Pagina * Model.TamanoPagina < Model.Total)
        {
            <a asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" asp-route-tamanoPagina="@Model.TamanoPagina" asp-route-periodoEscolarId="@Model.PeriodoEscolarId" asp-route-entidadAcademicaId="@Model.EntidadAcademicaId" asp-route-estado="@Model.Estado">Siguiente</a>
        }
    </div>
</div>
