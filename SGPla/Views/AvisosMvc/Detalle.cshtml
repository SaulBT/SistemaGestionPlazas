@model SGPla.Models.ViewModels.Avisos.AvisoMvcDetalleViewModel
@{
    ViewData["Title"] = $"Aviso {Model.Aviso.Id}";
    var puedeEditar = User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_EA)
        && (Model.Aviso.Estado is "CREADO" or "DEVUELTO_DGAA");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Aviso @Model.Aviso.Id</h1>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a Avisos</a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <dl class="row">
        <dt class="col-sm-3">Entidad Académica</dt><dd class="col-sm-9">@Model.Aviso.EntidadAcademica</dd>
        <dt class="col-sm-3">Periodo</dt><dd class="col-sm-9">@Model.Aviso.PeriodoEscolar</dd>
        <dt class="col-sm-3">Sistema educativo</dt><dd class="col-sm-9">@Model.Aviso.SistemaEducativo</dd>
        <dt class="col-sm-3">Artículo</dt><dd class="col-sm-9">@Model.Aviso.Articulo</dd>
        <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Aviso.TipoComunicado</dd>
        <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Model.Aviso.Estado</dd>
        <dt class="col-sm-3">Creado UTC</dt><dd class="col-sm-9"><time datetime="@Model.Aviso.CreadoEn.ToString("O")">@Model.Aviso.CreadoEn.ToString("u")</time></dd>
        @if (Model.Aviso.FechaPublicacion.HasValue)
        {
            <dt class="col-sm-3">Publicado</dt><dd class="col-sm-9">@Model.Aviso.FechaPublicacion.Value.ToString("yyyy-MM-dd") · <a href="@Model.Aviso.UrlPublicacion" target="_blank" rel="noopener noreferrer">Consultar publicación</a></dd>
        }
        @if (Model.Aviso.CanceladoEn.HasValue)
        {
            <dt class="col-sm-3">Cancelado UTC</dt><dd class="col-sm-9">@Model.Aviso.CanceladoEn.Value.ToString("u")</dd>
            <dt class="col-sm-3">Motivo</dt><dd class="col-sm-9">@Model.Aviso.MotivoCancelacion</dd>
        }
        @if (Model.Aviso.ArchivadoEn.HasValue)
        {
            <dt class="col-sm-3">Archivado UTC</dt><dd class="col-sm-9">@Model.Aviso.ArchivadoEn.Value.ToString("u")</dd>
        }
    </dl>

    @if (Model.Aviso.Estado == "PUBLICADO" && User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_EA))
    {
        <a class="btn btn-primary mb-3" asp-controller="SolicitudesMvc" asp-action="Index" asp-route-avisoId="@Model.Aviso.Id">Administrar Solicitudes</a>
    }

    @if (Model.Aviso.ModalidadRecepcionId.HasValue)
    {
        <h2 class="h5 mt-4">Recepción de documentación</h2>
        <dl class="row">
            <dt class="col-sm-3">Modalidad</dt><dd class="col-sm-9">@Model.Aviso.ModalidadRecepcion</dd>
            @if (!string.IsNullOrWhiteSpace(Model.Aviso.LugarRecepcion))
            {
                <dt class="col-sm-3">Lugar</dt><dd class="col-sm-9">@Model.Aviso.LugarRecepcion</dd>
            }
            <dt class="col-sm-3">Correo de contacto</dt><dd class="col-sm-9">@Model.Aviso.CorreoContacto</dd>
            <dt class="col-sm-3">Titular</dt><dd class="col-sm-9">@Model.Aviso.NombreTitular</dd>
            <dt class="col-sm-3">Consejo Técnico</dt><dd class="col-sm-9">@Model.Aviso.FechaConsejoTecnico</dd>
            <dt class="col-sm-3">Fecha de vacantes</dt><dd class="col-sm-9">@Model.Aviso.FechaVacantes</dd>
            <dt class="col-sm-3">Requisitos</dt><dd class="col-sm-9"><pre class="mb-0 text-wrap">@Model.Aviso.Requisitos</pre></dd>
        </dl>
        <ul class="list-group">
            @foreach (var horario in Model.Aviso.Horarios)
            {
                <li class="list-group-item">@horario.Fecha: @horario.HoraInicio.ToString("HH:mm")–@horario.HoraFin.ToString("HH:mm")</li>
            }
        </ul>
    }

    @if (Model.Aviso.Revisiones.Count > 0)
    {
        <h2 class="h5 mt-4">Historial de revisión</h2>
        <ol class="list-group list-group-numbered">
            @foreach (var revision in Model.Aviso.Revisiones)
            {
                <li class="list-group-item">
                    <strong>Revisión @revision.Numero</strong> · enviada UTC @revision.EnviadoEn.ToString("u")
                    @if (revision.Resultado is not null)
                    {
                        <span>· @revision.Resultado (@revision.ResueltoEn?.ToString("u"))</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(revision.Comentarios))
                    {
                        <p class="mb-0">@revision.Comentarios</p>
                    }
                </li>
            }
        </ol>
    }

    <h2 class="h5 mt-4">Documentos</h2>
    <ul class="list-group">
        @foreach (var documento in Model.Aviso.Documentos)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                <span>@documento.Tipo · v@documento.NumeroVersion · @documento.Nombre · @documento.Tamano bytes · @(documento.EsVigente ? "Vigente" : "Histórico")</span>
                <a class="btn btn-sm btn-outline-primary" asp-action="DescargarDocumento" asp-route-avisoId="@Model.Aviso.Id" asp-route-documentoId="@documento.Id">Descargar</a>
            </li>
        }
        @if (Model.Aviso.Documentos.Count == 0)
        {
            <li class="list-group-item text-muted">Aún no hay documentos.</li>
        }
    </ul>

    @if (puedeEditar)
    {
        @if (Model.Aviso.Estado == "CREADO")
        {
            <form method="post" asp-action="EliminarBorrador" asp-route-avisoId="@Model.Aviso.Id" class="mt-4"
                  onsubmit="return confirm('¿Eliminar físicamente este borrador y sus documentos? Las Ofertas volverán a estar disponibles.');">
                <button class="btn btn-outline-danger" type="submit">Eliminar borrador</button>
            </form>
        }
        <form method="post" asp-action="EnviarARevision" asp-route-avisoId="@Model.Aviso.Id" class="mt-4 border rounded p-3">
            <h2 class="h5">Datos para enviar a revisión</h2>
            <p class="text-muted">Al enviar, se congela la información principal y se crea una revisión ligada al documento original vigente.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="Envio.ModalidadRecepcionId">Modalidad de recepción</label>
                    <select class="form-select" asp-for="Envio.ModalidadRecepcionId" required>
                        <option value="">Selecciona modalidad</option>
                        @foreach (var option in Model.Datos.ModalidadesRecepcion)
                        {
                            <option value="@option.Id">@option.Texto</option>
                        }
                    </select>
                    <span asp-validation-for="Envio.ModalidadRecepcionId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Envio.LugarRecepcion">Lugar de recepción (si aplica)</label>
                    <input class="form-control" asp-for="Envio.LugarRecepcion" maxlength="500" />
                    <span asp-validation-for="Envio.LugarRecepcion" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Envio.Requisitos">Requisitos</label>
            <textarea class="form-control" asp-for="Envio.Requisitos" rows="4" required></textarea>
                    <span asp-validation-for="Envio.Requisitos" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Envio.CorreoContacto">Correo de contacto</label>
                    <input class="form-control" asp-for="Envio.CorreoContacto" type="email" maxlength="254" required />
                    <span asp-validation-for="Envio.CorreoContacto" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Envio.NombreTitular">Nombre del titular</label>
                    <input class="form-control" asp-for="Envio.NombreTitular" maxlength="200" required />
                    <span asp-validation-for="Envio.NombreTitular" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Envio.FechaConsejoTecnico">Fecha del Consejo Técnico</label>
                    <input class="form-control" asp-for="Envio.FechaConsejoTecnico" type="date" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Envio.FechaVacantes">Fecha de vacantes</label>
                    <input class="form-control" asp-for="Envio.FechaVacantes" type="date" required />
                </div>
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="h6 mb-0">Horarios de recepción</h3>
                        <button class="btn btn-sm btn-outline-secondary" type="button" id="agregarHorario">Agregar horario</button>
                    </div>
                    <div id="horariosAviso" class="row g-2 mt-1">
                        @for (var i = 0; i < Model.Envio.Horarios.Count; i++)
                        {
                            <div class="col-12 row g-2 horario-aviso">
                                <div class="col-md-4"><label class="form-label" for="Envio_Horarios_@(i)__Fecha">Fecha</label><input class="form-control" type="date" name="Envio.Horarios[@i].Fecha" id="Envio_Horarios_@(i)__Fecha" value="@Model.Envio.Horarios[i].Fecha.ToString("yyyy-MM-dd")" required /></div>
                                <div class="col-md-3"><label class="form-label" for="Envio_Horarios_@(i)__HoraInicio">Hora inicio</label><input class="form-control" type="time" name="Envio.Horarios[@i].HoraInicio" id="Envio_Horarios_@(i)__HoraInicio" value="@Model.Envio.Horarios[i].HoraInicio.ToString("HH:mm")" required /></div>
                                <div class="col-md-3"><label class="form-label" for="Envio_Horarios_@(i)__HoraFin">Hora fin</label><input class="form-control" type="time" name="Envio.Horarios[@i].HoraFin" id="Envio_Horarios_@(i)__HoraFin" value="@Model.Envio.Horarios[i].HoraFin.ToString("HH:mm")" required /></div>
                                <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-danger quitar-horario" type="button">Quitar</button></div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-12"><button class="btn btn-primary" type="submit">Enviar a revisión de DGAA</button></div>
            </div>
        </form>
        <script>
            (() => {
                const list = document.getElementById('horariosAviso');
                document.getElementById('agregarHorario').addEventListener('click', () => {
                    const i = list.querySelectorAll('.horario-aviso').length;
                    const row = document.createElement('div');
                    row.className = 'col-12 row g-2 horario-aviso';
                    row.innerHTML = `<div class="col-md-4"><label class="form-label" for="Envio_Horarios_${i}__Fecha">Fecha</label><input class="form-control" type="date" name="Envio.Horarios[${i}].Fecha" id="Envio_Horarios_${i}__Fecha" required /></div><div class="col-md-3"><label class="form-label" for="Envio_Horarios_${i}__HoraInicio">Hora inicio</label><input class="form-control" type="time" name="Envio.Horarios[${i}].HoraInicio" id="Envio_Horarios_${i}__HoraInicio" required /></div><div class="col-md-3"><label class="form-label" for="Envio_Horarios_${i}__HoraFin">Hora fin</label><input class="form-control" type="time" name="Envio.Horarios[${i}].HoraFin" id="Envio_Horarios_${i}__HoraFin" required /></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-danger quitar-horario" type="button">Quitar</button></div>`;
                    list.appendChild(row);
                });
                list.addEventListener('click', event => {
                    if (event.target.closest('.quitar-horario') && list.querySelectorAll('.horario-aviso').length > 1)
                        event.target.closest('.horario-aviso').remove();
                });
            })();
        </script>

        <form method="post" enctype="multipart/form-data" asp-action="SubirDocumentoOriginal" asp-route-avisoId="@Model.Aviso.Id" class="mt-3">
            <label class="form-label" for="archivo">Documento original (PDF, máximo 25 MB)</label>
            <div class="input-group">
                <input class="form-control" type="file" id="archivo" name="archivo" accept="application/pdf,.pdf" required />
                <button class="btn btn-outline-primary" type="submit">Guardar nueva versión</button>
            </div>
        </form>
    }

    @if (User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_EA) && Model.Aviso.Estado == "AVALADO_DGAA")
    {
        <form method="post" enctype="multipart/form-data" asp-action="SubirDocumentoFirmado" asp-route-avisoId="@Model.Aviso.Id" class="mt-4 border rounded p-3">
            <h2 class="h5">Registrar documento firmado</h2>
            <p class="text-muted">Carga el PDF firmado para completar la transición a FIRMADO.</p>
            <label class="form-label" for="archivoFirmado">Documento firmado (PDF, máximo 25 MB)</label>
            <div class="input-group">
                <input class="form-control" type="file" id="archivoFirmado" name="archivo" accept="application/pdf,.pdf" required />
                <button class="btn btn-primary" type="submit">Guardar documento firmado</button>
            </div>
        </form>
    }

    @if (User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_EA) && Model.Aviso.Estado == "FIRMADO")
    {
        <form method="post" asp-action="Publicar" asp-route-avisoId="@Model.Aviso.Id" class="mt-4 border rounded p-3">
            <h2 class="h5">Publicar Aviso</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="fechaPublicacion">Fecha de publicación</label>
                    <input class="form-control" type="date" id="fechaPublicacion" name="fechaPublicacion" required />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="urlPublicacion">URL de publicación</label>
                    <input class="form-control" type="url" id="urlPublicacion" name="urlPublicacion" maxlength="2048" placeholder="https://..." required />
                </div>
                <div class="col-12"><button class="btn btn-primary" type="submit">Confirmar publicación</button></div>
            </div>
        </form>
    }

    @if (User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_DGAA)
        && Model.Aviso.Estado is "DEVUELTO_DGAA" or "AVALADO_DGAA" or "FIRMADO")
    {
        <form method="post" asp-action="Cancelar" asp-route-avisoId="@Model.Aviso.Id" class="mt-4 border border-danger rounded p-3">
            <h2 class="h5">Cancelar Aviso</h2>
            <label class="form-label" for="motivoCancelacion">Motivo (obligatorio)</label>
            <textarea class="form-control" id="motivoCancelacion" name="motivo" rows="3" maxlength="1000" required></textarea>
            <button class="btn btn-outline-danger mt-3" type="submit">Cancelar Aviso y liberar Ofertas</button>
        </form>
    }

    @if (Model.Aviso.Estado is "PUBLICADO" or "CANCELADO")
    {
        @if (Model.Aviso.ArchivadoEn is null)
        {
            <form method="post" asp-action="Archivar" asp-route-avisoId="@Model.Aviso.Id" class="mt-4">
                <button class="btn btn-outline-secondary" type="submit">Archivar Aviso</button>
            </form>
        }
        else
        {
            <p class="text-muted mt-3">Este Aviso está archivado.</p>
        }
    }

    @if (User.IsInRole(SGPla.Commons.Constantes.COORDINADOR_DGAA) && Model.Aviso.Estado == "EN_REVISION_DGAA")
    {
        <form method="post" asp-action="ResolverRevision" asp-route-avisoId="@Model.Aviso.Id" class="mt-4 border rounded p-3">
            <h2 class="h5">Resolver revisión DGAA</h2>
            <p>El documento original de esta revisión y sus datos quedan conservados en el historial.</p>
            <label class="form-label" for="comentariosRevision">Comentarios (obligatorios al devolver)</label>
            <textarea class="form-control" id="comentariosRevision" name="comentarios" rows="3"></textarea>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" type="submit" name="avalar" value="true">Avalar</button>
                <button class="btn btn-outline-danger" type="submit" name="avalar" value="false">Devolver a Entidad Académica</button>
            </div>
        </form>
    }

    <h2 class="h5 mt-4">Ofertas vinculadas</h2>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption class="visually-hidden">Ofertas que participan en el intento de publicación</caption>
            <thead><tr><th>Clave de plaza</th><th>NRC</th><th>Programa</th><th>Experiencia educativa</th><th>Estado</th>@if (puedeEditar) { <th>Acciones</th> }</tr></thead>
            <tbody>
            @foreach (var oferta in Model.Aviso.Ofertas)
            {
                <tr>
                    <td>@oferta.ClavePlaza</td><td>@oferta.Nrc</td><td>@oferta.ProgramaEducativo</td>
                    <td>@oferta.ExperienciaEducativa</td><td>@oferta.EstadoOferta</td>
                    @if (puedeEditar)
                    {
                        <td>
                            <form method="post" asp-action="RetirarOferta" asp-route-avisoId="@Model.Aviso.Id" asp-route-avisoOfertaId="@oferta.AvisoOfertaId">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Retirar</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            @if (Model.Aviso.Ofertas.Count == 0)
            {
                <tr><td colspan="@(puedeEditar ? 6 : 5)" class="text-center text-muted">No hay Ofertas vinculadas.</td></tr>
            }
            </tbody>
        </table>
    </div>

    @if (puedeEditar)
    {
        <form method="post" asp-action="AgregarOfertas" asp-route-avisoId="@Model.Aviso.Id" class="mt-4">
            <fieldset>
                <legend class="h6">Agregar Ofertas disponibles</legend>
                @if (Model.Datos.OfertasDisponibles.Count == 0)
                {
                    <p class="text-muted">No hay Ofertas disponibles para este Aviso.</p>
                }
                @foreach (var option in Model.Datos.OfertasDisponibles)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="OfertaIds" value="@option.Id" id="oferta-@option.Id" />
                        <label class="form-check-label" for="oferta-@option.Id">@option.Texto</label>
                    </div>
                }
                <button class="btn btn-primary mt-3" type="submit" disabled="@(Model.Datos.OfertasDisponibles.Count == 0)">Agregar seleccionadas</button>
            </fieldset>
        </form>
    }
</div>
