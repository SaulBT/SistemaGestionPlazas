@model IReadOnlyList<SGPla.Models.DTOs.Docentes.DocenteDirectorioMvcFila>
@{
    ViewData["Title"] = "Directorio de docentes";
    var pagina = (int)ViewData["Pagina"]!;
    var tamano = (int)ViewData["TamanoPagina"]!;
    var totalPaginas = (int)ViewData["TotalPaginas"]!;
    var busqueda = ViewData["Busqueda"]?.ToString();
}

<form method="get" asp-controller="DocentesMvc" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-6">
        <label for="busqueda" class="form-label">Nombre o número de personal</label>
        <input id="busqueda" name="Busqueda" value="@busqueda" class="form-control" maxlength="100" />
    </div>
    <div class="col-auto align-self-end"><button class="btn btn-primary" type="submit">Buscar</button></div>
</form>

<p role="status">@ViewData["Total"] docentes</p>
<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Nombre</th><th>Número de personal</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="2">No se encontraron docentes.</td></tr>
        }
        else
        {
            foreach (var docente in Model)
            {
                <tr><td>@docente.Nombre</td><td>@(docente.NumeroPersonal ?? "Sin número de personal")</td></tr>
            }
        }
        </tbody>
    </table>
</div>

@if (totalPaginas > 1)
{
    <nav aria-label="Páginas del directorio">
        <ul class="pagination">
            <li class="page-item @(pagina <= 1 ? "disabled" : "")"><a class="page-link" asp-controller="DocentesMvc" asp-action="Index" asp-route-Busqueda="@busqueda" asp-route-Pagina="@(pagina - 1)" asp-route-TamanoPagina="@tamano">Anterior</a></li>
            <li class="page-item disabled"><span class="page-link">@pagina de @totalPaginas</span></li>
            <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")"><a class="page-link" asp-controller="DocentesMvc" asp-action="Index" asp-route-Busqueda="@busqueda" asp-route-Pagina="@(pagina + 1)" asp-route-TamanoPagina="@tamano">Siguiente</a></li>
        </ul>
    </nav>
}
