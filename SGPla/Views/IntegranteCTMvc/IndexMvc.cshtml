@model SGPla.Models.ViewModels.IntegranteCt.IntegranteConsejoTecnicoMvcIndexViewModel
@{
    Layout = "_LayoutEntidadAcademica";
    ViewData["Title"] = "Consejo Técnico";
    var totalPaginas = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Math.Max(1, Model.TamanoPagina)));
}

<div class="container py-4">
    <h1 class="h3">Consejo Técnico</h1>
    <p class="text-muted">Los cambios de cargo o tratamiento registran una nueva vigencia y conservan el historial.</p>

    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <form method="get" asp-action="Index" class="row g-2 mb-4">
        <div class="col-md-8"><label class="form-label" for="busqueda">Buscar integrante o cargo</label><input class="form-control" id="busqueda" name="busqueda" value="@Model.Busqueda" maxlength="200" /></div>
        <div class="col-auto align-self-end"><button class="btn btn-outline-primary" type="submit">Buscar</button></div>
    </form>

    <h2 class="h5">Registrar integrante</h2>
    <form method="post" asp-action="Crear" class="row g-2 mb-4">
        <div class="col-md-3"><label class="form-label" asp-for="Formulario.Nombre">Nombre completo</label><input class="form-control" asp-for="Formulario.Nombre" maxlength="200" required /></div>
        <div class="col-md-3"><label class="form-label" asp-for="Formulario.Cargo">Cargo</label><input class="form-control" asp-for="Formulario.Cargo" maxlength="200" required /></div>
        <div class="col-md-3"><label class="form-label" asp-for="Formulario.TratamientoAcademicoId">Tratamiento</label><select class="form-select" asp-for="Formulario.TratamientoAcademicoId" required><option value="">Selecciona un tratamiento</option>@foreach (var item in Model.Tratamientos) { <option value="@item.Id">@item.Nombre (@item.Grado)</option> }</select></div>
        <div class="col-md-2"><label class="form-label" asp-for="Formulario.FechaInicio">Inicio</label><input class="form-control" asp-for="Formulario.FechaInicio" type="date" required /></div>
        <div class="col-md-1 align-self-end"><button class="btn btn-primary" type="submit">Registrar</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption class="visually-hidden">Nombramientos y vigencias del Consejo Técnico</caption>
            <thead><tr><th>Nombre</th><th>Cargo</th><th>Tratamiento</th><th>Vigencia</th><th>Acciones</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Integrantes)
            {
                <tr>
                    <td>@item.Nombre</td><td>@item.Cargo</td><td>@item.Tratamiento (@item.Grado)</td>
                    <td>@item.FechaInicio.ToString("yyyy-MM-dd") – @(item.FechaFin?.ToString("yyyy-MM-dd") ?? "Actual")</td>
                    <td>
                    @if (item.FechaFin is null)
                    {
                        var inicioSiguiente = Model.Formulario.FechaInicio > item.FechaInicio
                            ? Model.Formulario.FechaInicio
                            : item.FechaInicio.AddDays(1);
                        <details>
                            <summary class="btn btn-sm btn-outline-primary">Nuevo cambio</summary>
                            <form method="post" asp-action="NuevaVigencia" asp-route-integranteId="@item.Id" class="row g-2 mt-2">
                                <div class="col-12"><label class="form-label" for="nombre-@item.Id">Nombre completo</label><input class="form-control" name="Formulario.Nombre" id="nombre-@item.Id" value="@item.Nombre" maxlength="200" required /></div>
                                <div class="col-12"><label class="form-label" for="cargo-@item.Id">Cargo</label><input class="form-control" name="Formulario.Cargo" id="cargo-@item.Id" value="@item.Cargo" maxlength="200" required /></div>
                                <div class="col-12"><label class="form-label" for="tratamiento-@item.Id">Tratamiento</label><select class="form-select" name="Formulario.TratamientoAcademicoId" id="tratamiento-@item.Id" required><option value="">Selecciona</option>@foreach (var option in Model.Tratamientos) { <option value="@option.Id" selected="@(option.Id == item.TratamientoAcademicoId)">@option.Nombre (@option.Grado)</option> }</select></div>
                                <div class="col-12"><label class="form-label" for="inicio-@item.Id">Inicio de la nueva vigencia</label><input class="form-control" name="Formulario.FechaInicio" id="inicio-@item.Id" type="date" value="@inicioSiguiente.ToString("yyyy-MM-dd")" required /></div>
                                <button class="btn btn-sm btn-primary" type="submit">Cerrar vigencia anterior y guardar</button>
                            </form>
                        </details>
                    }
                    @if (!item.TieneAsistencias)
                    {
                        <form method="post" asp-action="EliminarCapturaErronea" asp-route-integranteId="@item.Id" class="d-inline" onsubmit="return confirm('¿Eliminar esta captura sin referencias a Actas?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar captura errónea</button>
                        </form>
                    }
                    </td>
                </tr>
            }
            @if (Model.Integrantes.Count == 0) { <tr><td colspan="5" class="text-center text-muted">No hay integrantes registrados.</td></tr> }
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginación de integrantes" class="d-flex justify-content-between">
        <span>@Model.Total integrante(s)</span>
        <div class="d-flex gap-3">
            @if (Model.Pagina > 1) { <a asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina - 1)" asp-route-tamanoPagina="@Model.TamanoPagina">Anterior</a> }
            <span>Página @Model.Pagina de @totalPaginas</span>
            @if (Model.Pagina < totalPaginas) { <a asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina + 1)" asp-route-tamanoPagina="@Model.TamanoPagina">Siguiente</a> }
        </div>
    </nav>
</div>
