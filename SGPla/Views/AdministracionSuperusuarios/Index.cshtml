@model IReadOnlyList<SGPla.Models.DTOs.Auth.SuperusuarioAdministrable>
@{
    ViewData["Title"] = "Cuentas Superusuario";
}

<div class="container-fluid py-4">
    <h1 class="h3">Cuentas Superusuario</h1>
    <p class="text-muted">Las contraseñas temporales se guardan con Argon2id y obligan al cambio al iniciar sesión.</p>
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption class="visually-hidden">Cuentas activas de Superusuario</caption>
            <thead><tr><th>Nombre</th><th>Correo</th><th>Credencial</th><th>Restablecer contraseña</th><th>Cuenta</th></tr></thead>
            <tbody>
            @foreach (var cuenta in Model)
            {
                <tr>
                    <td>@cuenta.Nombre</td>
                    <td>@cuenta.Correo</td>
                    <td>@(cuenta.TieneCredencial ? "Activa" : "Sin credencial local")</td>
                    <td>
                        @if (cuenta.TieneCredencial)
                        {
                            <form method="post" asp-action="Restablecer" asp-route-id="@cuenta.Id" class="d-grid gap-2">
                                <label class="visually-hidden" for="temporal-@cuenta.Id">Contraseña temporal para @cuenta.Correo</label>
                                <input class="form-control" id="temporal-@cuenta.Id" name="contrasenaTemporal" type="password" autocomplete="new-password" required />
                                <label class="visually-hidden" for="confirmar-@cuenta.Id">Confirmar contraseña temporal para @cuenta.Correo</label>
                                <input class="form-control" id="confirmar-@cuenta.Id" name="confirmarContrasenaTemporal" type="password" autocomplete="new-password" required />
                                <button class="btn btn-outline-primary" type="submit">Restablecer</button>
                            </form>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="Desactivar" asp-route-id="@cuenta.Id"
                              onsubmit="return confirm('¿Desactivar la cuenta de @cuenta.Correo?');">
                            <button class="btn btn-outline-danger" type="submit">Desactivar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No hay cuentas Superusuario activas.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
