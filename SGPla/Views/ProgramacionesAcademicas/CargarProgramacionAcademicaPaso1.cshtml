@using SGPla.Models.DTOs.Oferta
@using SGPla.Models.DTOs.ProgramacionAcademica
@using SGPla.Models.ViewModels.ProgramacionesAcademicas
@model CargarProgramacionAcademica1ViewModel

@{
	ViewData["Title"] = "Crear programación académica";
}

@await Component.InvokeAsync("Stepper", new StepperModel
{
	PasoActual = 1,
	Paso1Texto = "Subir Archivo",
	Paso2Texto = "Programación Académica"
})

<form id="form" class="formulario-con-barra-acciones" method="post" action="@Url.Action("RevisarListaDeExperienciasEducativas", "ProgramacionesAcademicas")" enctype="multipart/form-data">
	@Html.AntiForgeryToken()

	<div class="d-flex flex-column gap-3">

		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Region",
			Label = "Región:",
			Options = Model.Regiones,
			Name = "Region",
			SelectedValue = Model.Region?.ToString(),
			Error = ViewData.ModelState["Region"]?.Errors.FirstOrDefault()?.ErrorMessage
		})

		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Modalidad",
			Label = "Modalidad:",
			Options = Model.Modalidades,
			Name = "Modalidad",
			SelectedValue = Model.Modalidad,
			Error = ViewData.ModelState["Modalidad"]?.Errors.FirstOrDefault()?.ErrorMessage
		})

		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "PlanEstudios",
			Label = "Plan de Estudios:",
			Options = Model.Planes,
			Name = "IdPlanEstudios",
			SelectedValue = Model.IdPlanEstudios?.ToString(),
			Error = ViewData.ModelState["IdPlanEstudios"]?.Errors.FirstOrDefault()?.ErrorMessage
		})

		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Entidad",
			Label = "Entidad Académica:",
			Options = Model.Entidades,
			Name = "IdEntidadAcademica",
			SelectedValue = Model.IdEntidadAcademica?.ToString(),
			Error = ViewData.ModelState["IdEntidadAcademica"]?.Errors.FirstOrDefault()?.ErrorMessage
		})

		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Periodo",
			Label = "Periodo Escolar:",
			Options = Model.Periodos,
			Name = "IdPeriodo",
			SelectedValue = Model.IdPeriodo?.ToString(),
			Error = ViewData.ModelState["IdPeriodo"]?.Errors.FirstOrDefault()?.ErrorMessage
		})

		<!-- BOTONES SUBIR ARCHIVO -->
		<div class="d-flex flex-column gap-3">

			<div style="display:inline-flex; gap:10px">
				@await Component.InvokeAsync("Boton", new
				{
					Accion = "cargar",
					Texto = "Subir Archivo Vacantes",
					OnClick = "abrirModalArchivo1()"
				})

				<div id="banderaArchivo1" class="text-wrapper" style="display:inline-flex; align-content:center">
					<i class="bi bi-file-earmark-x-fill" style="font-size:20px;color:var(--negativo-rojo-letra)"></i>
				</div>
			</div>

			<div style="display:inline-flex; gap:10px">
				@await Component.InvokeAsync("Boton", new
				{
					Accion = "cargar",
					Texto = "Subir Archivo Descargas",
					OnClick = "abrirModalArchivo2()"
				})

				<div id="banderaArchivo2" class="text-wrapper" style="display:inline-flex; align-content:center">
					<i class="bi bi-file-earmark-x-fill" style="font-size:20px;color:var(--negativo-rojo-letra)"></i>
				</div>
			</div>

			<div style="display:inline-flex; gap:10px">
				@await Component.InvokeAsync("Boton", new
				{
					Accion = "cargar",
					Texto = "Subir Archivo Cargas",
					OnClick = "abrirModalArchivo3()"
				})

				<div id="banderaArchivo3" class="text-wrapper" style="display:inline-flex; align-content:center">
					<i class="bi bi-file-earmark-x-fill" style="font-size:20px;color:var(--negativo-rojo-letra)"></i>
				</div>
			</div>
		</div>

	</div>

	<!-- BOTONES -->
	<div class="barra-acciones-fija">
		<a href="@Url.Action("Index", "ProgramacionesAcademicas")" style="display: inline-block; text-decoration: none;">
			@await Component.InvokeAsync("Boton", new
			{
				Accion = "Cancelar"
			})
		</a>
		@await Component.InvokeAsync("Boton", new
		{
			Accion = "siguiente",
			OnClick = "document.getElementById('form').submit()"
		})
	</div>

	<!-- MODALES -->
	<div>
		@await Component.InvokeAsync("ModalArchivo",
		  new ModalArchivoModel
		  {
			  Id = "modalArchivo1",
			  IdBandera = "banderaArchivo1",
			  NombreArchivo = "ArchivoVacantes",
			  FormatosAceptados = ".xlsx, .xls",
			  TamanioMaximo = 20
		  })

		@await Component.InvokeAsync("ModalArchivo",
		new ModalArchivoModel
		{
			Id = "modalArchivo2",
			IdBandera = "banderaArchivo2",
			NombreArchivo = "ArchivoDescargas",
			FormatosAceptados = ".xlsx, .xls",
			TamanioMaximo = 20
		})

		@await Component.InvokeAsync("ModalArchivo",
		new ModalArchivoModel
		{
			Id = "modalArchivo3",
			IdBandera = "banderaArchivo3",
			NombreArchivo = "ArchivoCargas",
			FormatosAceptados = ".xlsx, .xls",
			TamanioMaximo = 20
		})
	</div>

</form>

<script>
		function abrirModalArchivo1() {
		abrirModal("modalArchivo1");
	}
	function abrirModalArchivo2() {
		abrirModal("modalArchivo2");
	}

	function abrirModalArchivo3() {
		abrirModal("modalArchivo3");
	}


	document.addEventListener("DOMContentLoaded", function () {

		const region = document.querySelector("[name='Region']");
		const entidad = document.querySelector("[name='IdEntidadAcademica']");
		const modalidad = document.querySelector("[name='Modalidad']");
		const plan = document.querySelector("[name='IdPlanEstudios']");

		async function cargarPlanes() {
			if (!entidad || !modalidad || !plan || !entidad.value || !modalidad.value) return;
			const response = await fetch(`/ProgramacionesAcademicas/ObtenerPlanes?entidad=${encodeURIComponent(entidad.value)}&modalidad=${encodeURIComponent(modalidad.value)}`);
			const data = await response.json();
			const opcionInicial = plan.options[0];
			plan.innerHTML = "";
			plan.appendChild(opcionInicial);
			data.forEach(p => {
				const option = document.createElement("option");
				option.value = p.value;
				option.text = p.text;
				plan.appendChild(option);
			});
		}

		async function cargarEntidades() {
			if (!region || !entidad) return;

			const reg = region.value;
			const defaultOption = entidad.options[0];

			if (!reg) {
				entidad.innerHTML = "";
				entidad.appendChild(defaultOption);
				entidad.selectedIndex = 0;
				return;
			}

			try {
				const response = await fetch(
					`/ProgramacionesAcademicas/ObtenerEntidades?region=${encodeURIComponent(reg)}`
				);
				const data = await response.json();

				entidad.innerHTML = "";
				entidad.appendChild(defaultOption);

				data.forEach(e => {
					const option = document.createElement("option");
					option.value = e.value;
					option.text = e.text;
					entidad.appendChild(option);
				});
			} catch (error) {
				console.error("Error cargando entidades:", error);
			}
		}

		region?.addEventListener("change", cargarEntidades);
		entidad?.addEventListener("change", cargarPlanes);
		modalidad?.addEventListener("change", cargarPlanes);
	});
</script>

@section Scripts {
	<script src="~/js/cargarArchivo.js"></script>
}
