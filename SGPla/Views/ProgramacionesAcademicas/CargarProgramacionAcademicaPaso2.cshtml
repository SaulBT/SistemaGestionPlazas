@using SGPla.Models.DTOs.Oferta
@using SGPla.Models.DTOs.ProgramacionAcademica

@using SGPla.Models.ViewModels.ProgramacionesAcademicas
@model CargarProgramacionAcademica2ViewModel

@{
	Layout = "_LayoutSuperUsuario";
	ViewData["Title"] = "Experiencias Educativas";

	string Horario(HorarioDia? h) => h is null ? "—" : $"{h.Inicio:hh\\:mm}-{h.Fin:hh\\:mm}";
}
@await Component.InvokeAsync("Stepper", new StepperModel
{
	PasoActual = 2,
	Paso1Texto = "Subir Archivo",
	Paso2Texto = "Experiencias Educativas"
})


<div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">

	<div id="contenedorRegion" style="flex:1; min-width:0;">
		@await Component.InvokeAsync("InputField", new InputFieldModel
		{
			Id = "region",
			Name = "Region",
			Label = "Región:",
			Valor = Model.Region,
			Flexible = true,
			Error = ViewData.ModelState["Region"]?.Errors.FirstOrDefault()?.ErrorMessage,
			MaximoCaracteres = 5,
			Disabled = true
		})
	</div>

	<div id="contenedorEntidadAcademica" style="flex:3; min-width:0;">
		@await Component.InvokeAsync("InputField", new InputFieldModel
		{
			Id = "entidadAcademica",
			Name = "EntidadAcademica",
			Label = "Entidad Académica:",
			Valor = Model.NombreEntidadAcademica,
			Flexible = true,
			Error = ViewData.ModelState["NombreEntidadAcademica"]?.Errors.FirstOrDefault()?.ErrorMessage,
			MaximoCaracteres = 94,
			Disabled = true

		})
	</div>

	<div id="contenedorPeriodo" style="flex:3; min-width:0;">
		@await Component.InvokeAsync("InputField", new InputFieldModel
		{
			Id = "periodo",
			Name = "Periodo",
			Label = "Periodo:",
			Valor = Model.NombrePeriodo,
			Flexible = true,
			Error = ViewData.ModelState["NombrePeriodo"]?.Errors.FirstOrDefault()?.ErrorMessage,
			MaximoCaracteres = 94,
			Disabled = true
		})
	</div>

</div>

<div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">

	<div id="contenedorPrograma" style="flex:3; min-width:0;">
		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Programa",
			Label = "Programa Educativo:",
			Options = Model.Programas,
			Name = "Programa",
			SelectedValue = Model.ProgramaSeleccionado,
			Error = ViewData.ModelState["Programa"]?.Errors.FirstOrDefault()?.ErrorMessage
		})
	</div>
</div>

<div class="tabs-container" id="miTabs">

	<div class="tabs-header">

		<button class="tab-button active" data-tab="0"
				onclick="seleccionarTab('miTabs', 0)">
			Asignadas
		</button>

		<button class="tab-button"
				data-tab="1"
				onclick="seleccionarTab('miTabs', 1)">
			Vacantes
		</button>

	</div>

	<div class="tabs-body">

		<div class="tab-content active" data-tab="0">
			@await Component.InvokeAsync("Table", Model.TableAsignadas)
		</div>

		<div class="tab-content" data-tab="1">
			<div class="mb-4" style="max-width:300px;">
				@await Component.InvokeAsync("SelectField", new SelectFieldModel
				{
					Id = "Articulo",
					Label = "Artículo: ",
					Options = Model.Articulos,
					Name = "Articulo",
					SelectedValue = Model.IdArticulo?.ToString(),
					Error = ViewData.ModelState["Articulo"]?.Errors.FirstOrDefault()?.ErrorMessage
				})
			</div>

			@await Component.InvokeAsync("Table", Model.TableVacantes)
		</div>

	</div>

</div>

	



<form method="post" action="@Url.Action("Guardar", "ProgramacionesAcademicas")">
	@Html.AntiForgeryToken()

	<!-- Botones -->
	<div style="display:flex; justify-content:flex-end; gap:var(--button-gap)">
		<a href="@Url.Action("Index", "ProgramacionesAcademicas")" style="display: inline-block; text-decoration: none;">
			@await Component.InvokeAsync("Boton", new
			{
				Accion = "Cancelar"
			})
		</a>
		@await Component.InvokeAsync("Boton", new
		{
			Accion = "Guardar",
			ButtonType = "submit"
		})
	</div>
</form>


<script>
			function seleccionarTab(containerId, index) {

		const container = document.getElementById(containerId);

		const buttons = container.querySelectorAll(".tab-button");
		const contents = container.querySelectorAll(".tab-content");

		buttons.forEach(b => b.classList.remove("active"));
		contents.forEach(c => c.classList.remove("active"));

		const btn = container.querySelector(`[data-tab="${index}"].tab-button`);
		const content = container.querySelector(`[data-tab="${index}"].tab-content`);

		if (!btn || !content) return;

		btn.classList.add("active");
		content.classList.add("active");

		localStorage.setItem(`tabs-${containerId}`, index);
	}
</script>


<script>
	document.getElementById("Articulo").addEventListener("change", async function () {
		const response = await fetch(
			`/ProgramacionesAcademicas/AsignarArticulo?idArticulo=${this.value}`,
			{ method: "POST" }
		);

		const html = await response.text();
		document.open();
		document.write(html);
		document.close();
	});
</script>

<script>
	document.getElementById("Programa")
	.addEventListener("change", function () {

		const programa = encodeURIComponent(this.value);

		window.location =
			`/ProgramacionesAcademicas/FiltrarPrograma?programa=${programa}`;
	});
</script>


<script>
				window.addEventListener("load", () => {

		document.querySelectorAll(".tabs-container").forEach(container => {

			const containerId = container.id;

			const savedIndex = localStorage.getItem(`tabs-${containerId}`);

			if (savedIndex === null) return;

			seleccionarTab(containerId, parseInt(savedIndex));
		});

	});
</script>