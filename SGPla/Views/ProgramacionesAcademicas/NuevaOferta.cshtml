@model SGPla.Models.ViewModels.ProgramacionesAcademicas.CrearOfertaViewModel
@{
    ViewData["Title"] = "Crear Oferta";
}
<div class="container py-3">
    <h1>Crear Oferta</h1>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <section class="card card-body mb-3" aria-label="Programación seleccionada">
        <p class="mb-1"><strong>Entidad:</strong> @Model.Programacion?.EntidadAcademica</p>
        <p class="mb-1"><strong>Programa:</strong> @Model.Programacion?.ProgramaEducativo</p>
        <p class="mb-1"><strong>Experiencia Educativa:</strong> @Model.Programacion?.ExperienciaEducativa</p>
        <p class="mb-0"><strong>NRC:</strong> @Model.Programacion?.Nrc</p>
    </section>
    @if (Model.Programacion?.TieneDocenteVigente == true)
    {
        <div class="alert alert-info">La programación tiene docente vigente. Debes capturar una justificación para crear la Oferta.</div>
    }
    <form method="post" asp-controller="OfertasMvc" asp-action="Nueva" asp-route-programacionId="@Model.ProgramacionAcademicaId" class="card card-body" style="max-width:850px">
        @Html.AntiForgeryToken()
        <input asp-for="ProgramacionAcademicaId" type="hidden" />
        <div class="mb-3"><label asp-for="ClavePlaza" class="form-label">Clave de plaza</label><input asp-for="ClavePlaza" class="form-control" maxlength="100" required /><span asp-validation-for="ClavePlaza" class="text-danger"></span></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="TipoPlazaId" class="form-label">Tipo de plaza</label><select asp-for="TipoPlazaId" class="form-select" required><option value="">Selecciona</option>@foreach (var item in Model.TiposPlaza) { <option value="@item.Id">@item.Nombre</option> }</select><span asp-validation-for="TipoPlazaId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="TipoContratacionId" class="form-label">Tipo de contratación</label><select asp-for="TipoContratacionId" class="form-select" required><option value="">Selecciona</option>@foreach (var item in Model.TiposContratacion) { <option value="@item.Id">@item.Nombre</option> }</select><span asp-validation-for="TipoContratacionId" class="text-danger"></span></div>
        </div>
        <div class="my-3"><label asp-for="PerfilSolicitado" class="form-label">Perfil solicitado</label><textarea asp-for="PerfilSolicitado" class="form-control" rows="5" required></textarea><span asp-validation-for="PerfilSolicitado" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Justificacion" class="form-label">Justificación</label><textarea asp-for="Justificacion" class="form-control" rows="3" maxlength="1000"></textarea><span asp-validation-for="Justificacion" class="text-danger"></span></div>
        <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Crear Oferta</button><a class="btn btn-secondary" href="/ProgramacionesAcademicas">Cancelar</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
