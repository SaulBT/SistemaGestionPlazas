@using SGPla.Models.Componentes
@using SGPla.Models.ViewModels.ProgramacionesAcademicas
@model ProgramacionPlaneaViewModel

@{
    ViewData["Title"] = "Programación PLANEA";
    ViewBag.RegresarUrl = Url.Action("Index", "ProgramacionesAcademicas");
    var ultima = Model.UltimaSincronizacionPlanea;
    var tabla = await Component.InvokeAsync("Table", Model.TablaPlanea);
}

<div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">
    <div style="flex:1; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "region",
            Name = "Region",
            Label = "Región:",
            Valor = Model.Region,
            Flexible = true,
            MaximoCaracteres = 5,
            Disabled = true
        })
    </div>
    <div style="flex:3; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "entidadAcademica",
            Name = "EntidadAcademica",
            Label = "Entidad Académica:",
            Valor = Model.NombreEntidadAcademica,
            Flexible = true,
            MaximoCaracteres = 94,
            Disabled = true
        })
    </div>
    <div style="flex:3; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "periodo",
            Name = "Periodo",
            Label = "Periodo:",
            Valor = Model.NombrePeriodo,
            Flexible = true,
            MaximoCaracteres = 94,
            Disabled = true
        })
    </div>
    <div style="flex:3; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "programa",
            Name = "Programa",
            Label = "Programa Educativo:",
            Valor = Model.NombrePrograma,
            Flexible = true,
            MaximoCaracteres = 94,
            Disabled = true
        })
    </div>
    <div style="flex:2; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "codigoPlan",
            Name = "CodigoPlan",
            Label = "Código de plan:",
            Valor = Model.CodigoPlan,
            Flexible = true,
            MaximoCaracteres = 50,
            Disabled = true
        })
    </div>
</div>

<div style="display:flex;
    gap:10px;
    padding:var(--padding-sm);
    align-items:center;
    justify-content:space-between;
    margin-top:15px;">
    <form method="get" action="@Url.Action("ProgramacionPlanea", "ProgramacionesAcademicas")">

        <input type="hidden" name="idPlanEstudios" value="@Model.IdPlanEstudios" />
        <input type="hidden" name="idPeriodo" value="@Model.IdPeriodo" />

        @await Component.InvokeAsync("Buscador", new BuscadorModel
        {
            Name = "busqueda",
            Placeholder = "Buscar NRC o experiencia educativa...",
            Value = Context.Request.Query["busqueda"]
        })

    </form>

    @if (ultima is not null)
    {
        <small class="text-muted">
            Última sincronización con PLANEA: @((ultima.FechaFin ?? ultima.FechaInicio).ToString("dd/MM/yyyy HH:mm"))
        </small>
    }
</div>

@if (Model.HayPendientes)
{
    <form id="formAprobarPlanea" method="post" asp-action="AprobarProgramacionPlanea" asp-controller="ProgramacionesAcademicas">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idPlanEstudios" value="@Model.IdPlanEstudios" />
        <input type="hidden" name="idPeriodo" value="@Model.IdPeriodo" />

        <div style="display:flex; gap:20px; padding:var(--padding-sm); align-items:flex-end; flex-wrap:wrap;">
            <span id="contadorSeleccionPlanea" class="text-muted" aria-live="polite"></span>

            <div style="margin-left:auto;">
                @await Component.InvokeAsync("Boton", new { texto = "Confirmar programación", tipo = "primario", id = "btnConfirmarPlanea", onClick = "confirmarProgramacionPlanea()" })
            </div>
        </div>

        <div style="display:flex; gap:10px; padding-top:0px; justify-content:left">
            @tabla
        </div>
    </form>

    @await Component.InvokeAsync("Modal", new SGPla.Models.ModalModel
    {
        Id = "modalConfirmacion",
        Tipo = "confirm",
        Titulo = "Confirmar programación",
        Mensaje = "",
        OnConfirm = "confirmarModal()",
        OnCancel = "cerrarModal('modalConfirmacion')"
    })
}
else
{
    <div style="display:flex; gap:10px; padding-top:0px; justify-content:left">
        @tabla
    </div>
}

<form id="formRestaurarPlanea" method="post" asp-action="RestaurarCopiaPlanea" asp-controller="ProgramacionesAcademicas">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idExperienciaEducativaPeriodo" id="idCopiaRestaurar" value="" />
    <input type="hidden" name="idPlanEstudios" value="@Model.IdPlanEstudios" />
    <input type="hidden" name="idPeriodo" value="@Model.IdPeriodo" />
</form>

<script>
    function restaurarCopiaPlanea(id) {
        document.getElementById('idCopiaRestaurar').value = id;
        document.getElementById('formRestaurarPlanea').submit();
    }

    (function () {
        const form = document.getElementById('formAprobarPlanea');
        if (!form) return;

        const casillas = () => Array.from(form.querySelectorAll('input[type=checkbox][name=idsAprobados]:not(:disabled)'));
        // «Seleccionar todos los pendientes» vive en el encabezado de la primera columna.
        const todos = document.createElement('input');
        todos.type = 'checkbox';
        todos.id = 'seleccionarTodosPlanea';
        todos.checked = true;
        todos.title = 'Seleccionar todos los pendientes';
        todos.setAttribute('aria-label', 'Seleccionar todos los pendientes');
        form.querySelector('#tablaPlanea thead th:first-child').appendChild(todos);
        const contador = document.getElementById('contadorSeleccionPlanea');

        function actualizar() {
            const lista = casillas();
            const marcadas = lista.filter(c => c.checked).length;
            contador.textContent = `${marcadas} de ${lista.length} seleccionados`;
            todos.checked = lista.length > 0 && marcadas === lista.length;
        }

        todos.addEventListener('change', () => {
            casillas().forEach(c => c.checked = todos.checked);
            actualizar();
        });
        // La tabla pagina en el cliente: las filas ocultas siguen en el DOM y se envían con el form.
        form.addEventListener('change', e => {
            if (e.target.name === 'idsAprobados') actualizar();
        });
        actualizar();

        window.confirmarProgramacionPlanea = function () {
            const lista = casillas();
            const aprobar = lista.filter(c => c.checked).length;
            const descartar = lista.length - aprobar;
            const mensaje = aprobar === 0
                ? `Se descartarán todos los NRC pendientes (${descartar}). ¿Confirmar?`
                : `Se crearán ${aprobar} ofertas y se descartarán ${descartar} NRC. ¿Confirmar?`;

            abrirModalConfirmacion(mensaje, () => form.submit());
        };
    })();
</script>
