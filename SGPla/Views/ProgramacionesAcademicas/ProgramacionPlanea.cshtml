@using SGPla.Models.Componentes
@using SGPla.Models.ViewModels.ProgramacionesAcademicas
@model ProgramacionPlaneaViewModel

@{
    ViewData["Title"] = "Programación PLANEA";
    ViewBag.RegresarUrl = Url.Action("Index", "ProgramacionesAcademicas");
    var ultima = Model.UltimaSincronizacionPlanea;
}

<div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">
    <div style="flex:1; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "region",
            Name = "Region",
            Label = "Región:",
            Valor = Model.Region,
            Flexible = true,
            MaximoCaracteres = 5,
            Disabled = true
        })
    </div>
    <div style="flex:3; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "entidadAcademica",
            Name = "EntidadAcademica",
            Label = "Entidad Académica:",
            Valor = Model.NombreEntidadAcademica,
            Flexible = true,
            MaximoCaracteres = 94,
            Disabled = true
        })
    </div>
    <div style="flex:3; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "periodo",
            Name = "Periodo",
            Label = "Periodo:",
            Valor = Model.NombrePeriodo,
            Flexible = true,
            MaximoCaracteres = 94,
            Disabled = true
        })
    </div>
    <div style="flex:3; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "programa",
            Name = "Programa",
            Label = "Programa Educativo:",
            Valor = Model.NombrePrograma,
            Flexible = true,
            MaximoCaracteres = 94,
            Disabled = true
        })
    </div>
    <div style="flex:2; min-width:0;">
        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "codigoPlan",
            Name = "CodigoPlan",
            Label = "Código de plan:",
            Valor = Model.CodigoPlan,
            Flexible = true,
            MaximoCaracteres = 50,
            Disabled = true
        })
    </div>
</div>

<div style="display:flex;
    gap:10px;
    padding:var(--padding-sm);
    align-items:center;
    justify-content:space-between;
    margin-top:15px;">
    <form method="get" action="@Url.Action("ProgramacionPlanea", "ProgramacionesAcademicas")">

        <input type="hidden" name="idPlanEstudios" value="@Model.IdPlanEstudios" />
        <input type="hidden" name="idPeriodo" value="@Model.IdPeriodo" />

        @await Component.InvokeAsync("Buscador", new BuscadorModel
        {
            Name = "busqueda",
            Placeholder = "Buscar NRC o experiencia educativa...",
            Value = Context.Request.Query["busqueda"]
        })

    </form>

    @if (ultima is not null)
    {
        <small class="text-muted">
            Última sincronización con PLANEA: @((ultima.FechaFin ?? ultima.FechaInicio).ToString("dd/MM/yyyy HH:mm"))
        </small>
    }
</div>

<div style="display:flex; gap:10px; padding-top:0px; justify-content:left">
    @await Component.InvokeAsync("Table", Model.TablaPlanea)
</div>

<script>
    // La tabla pagina en servidor: conserva plan, periodo y búsqueda de la URL actual.
    function cambiarPaginaPlanea(valor, esCambioTamano = false) {
        const params = new URLSearchParams(window.location.search);

        if (esCambioTamano) {
            params.set("cantidad", valor);
            params.set("pagina", 1);
        } else {
            params.set("pagina", valor);
        }

        window.location.search = params.toString();
    }
</script>
