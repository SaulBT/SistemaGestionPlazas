@using SGPla.Models.ViewModels.ProgramacionesAcademicas
@model ProgramacionAcademicaImportarViewModel
@{ ViewData["Title"] = "Importar Programación Académica"; }
<div class="container py-3">
    <p><a href="/ProgramacionesAcademicas">← Programación Académica</a></p><h1>Importar Vacantes y Descargas</h1>
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form method="post" action="/ProgramacionesAcademicas/Importar" enctype="multipart/form-data" class="card card-body" style="max-width:900px">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="PeriodoEscolarId" class="form-label">Periodo</label><select asp-for="PeriodoEscolarId" class="form-select" required><option value="">Selecciona</option>@foreach (var item in Model.Periodos) { <option value="@item.Id">@item.Nombre</option> }</select></div>
            <div class="col-md-6"><label asp-for="EntidadAcademicaId" class="form-label">Entidad Académica</label><select asp-for="EntidadAcademicaId" class="form-select" required><option value="">Selecciona</option>@foreach (var item in Model.Entidades) { <option value="@item.Id">@item.Nombre</option> }</select></div>
            <div class="col-md-6"><label asp-for="ArchivoVacantes" class="form-label">Archivo Vacantes (.xls, .xlsx o .html)</label><input asp-for="ArchivoVacantes" type="file" class="form-control" accept=".xls,.xlsx,.html,.htm" required /></div>
            <div class="col-md-6"><label asp-for="ArchivoDescargas" class="form-label">Archivo Descargas (.xls, .xlsx o .html)</label><input asp-for="ArchivoDescargas" type="file" class="form-control" accept=".xls,.xlsx,.html,.htm" required /></div>
        </div>
        <div class="alert alert-info mt-3 mb-0">Se importan únicamente periodo, NRC y relación con Programa/EE. Cargas se retiró; horarios y docentes se obtendrán de PLANEA. Los archivos se procesan temporalmente y no se almacenan.</div>
        <div class="d-flex gap-2 mt-3"><button class="btn btn-primary">Importar programaciones</button><a href="/ProgramacionesAcademicas" class="btn btn-secondary">Cancelar</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
