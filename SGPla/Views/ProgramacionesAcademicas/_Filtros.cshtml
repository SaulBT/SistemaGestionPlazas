@using SGPla.Models.ViewModels.ProgramacionesAcademicas
@model IndexViewModel

<div id="filtrosContainer" style="display: inline-flex; gap: 10px; padding-bottom: 20px; transition: all 0.3s ease;">
	@await Component.InvokeAsync("SelectField", new SelectFieldModel
	{
		Id = "Region",
		Label = "Región: ",
		Options = Model.Regiones,
		Name = "Region",
		SelectedValue = Model.Region?.ToString(),
		Error = ViewData.ModelState["Region"]?.Errors.FirstOrDefault()?.ErrorMessage
	})

	<div id="contenedorEntidad">
		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Entidad",
			Label = "Entidad Académica: ",
			Options = Model.Entidades,
			Name = "IdEntidadAcademica",
			SelectedValue = Model.IdEntidadAcademica?.ToString(),
			Error = ViewData.ModelState["IdEntidadAcademica"]?.Errors.FirstOrDefault()?.ErrorMessage
		})
	</div>

	<div id="contenedorPrograma">
		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Programa",
			Label = "Programa Educativo: ",
			Options = Model.Programas,
			Name = "IdProgramaEducativo",
			SelectedValue = Model.IdProgramaEducativo?.ToString(),
			Error = ViewData.ModelState["IdProgramaEducativo"]?.Errors.FirstOrDefault()?.ErrorMessage
		})
	</div>

	<div>

		@await Component.InvokeAsync("SelectField", new SelectFieldModel
		{
			Id = "Periodo",
			Label = "Periodo: ",
			Options = Model.Periodos,
			Name = "IdPeriodo",
			SelectedValue = Model.IdPeriodo?.ToString(),
			Error = ViewData.ModelState["IdPeriodo"]?.Errors.FirstOrDefault()?.ErrorMessage
		})
	</div>
</div>