@using SGPla.Models.ViewModels.PlanesEstudios
@model PlanEstudiosMvcExperienciaViewModel
@{ ViewData["Title"] = "Editar Experiencia Educativa"; }
<div class="container py-3"><h1>Editar Experiencia Educativa</h1><p>Materia y curso son códigos inmutables.</p><div asp-validation-summary="ModelOnly" class="text-danger"></div><form asp-action="EditarExperiencia" method="post" class="card card-body" style="max-width:800px">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="PlanEstudiosId" type="hidden" /><partial name="_FormularioExperienciaMvc" model="Model" /><div class="d-flex gap-2"><button class="btn btn-primary">Guardar</button><a asp-action="Ver" asp-route-id="@Model.PlanEstudiosId" class="btn btn-secondary">Cancelar</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
