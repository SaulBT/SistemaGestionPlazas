@model SGPla.Models.ViewModels.PlanesEstudios.CargarPlanPaso2ViewModel
@{
	ViewData["Title"] = "Cargar Plan de Estudios";
}

<form id="form" action="@Url.Action("GuardarPlanEstudios", "PlanesEstudios")" method="post" action="" enctype="multipart/form-data">
    <!-- BLOQUE SUPERIOR -->
    <div class="d-flex row gap-2" style="margin-block-end: 1em">
        <!-- PRIMERA LÍNEA-->
        <div class="d-flex gap-2">
            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Name = "Region",
                Id = "ifRegion",
                Label = "Región:",
                Valor = Model.Region,
                Disabled = true,
                Flexible = true
            })
            <input type="hidden" name="Region" value="@Model.Region" />

            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Name = "Area",
                Label = "Área:",
                Valor = Model.NombreArea,
                Disabled = true,
                Flexible = true
            })
            <input type="hidden" id="ifArea" value="@Model.IdAreaAcademica" />
            <input type="hidden" name="NombreArea" value="@Model.NombreArea" />

            <input type="hidden" id="entidad" value="@Model.IdEntidadAcademica" />

            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Id = "ifProgramaEducativo",
                Name = "ProgramaEducativo",
                Label = "Programa Educativo:",
                Valor = Model.NombrePrograma,
                Disabled = true,
                Flexible = true
            })
            <input type="hidden" id="IdProgramaEducativo" name="IdProgramaEducativo" value="@Model.IdProgramaEducativo" />
            <input type="hidden" name="NombrePrograma" value="@Model.NombrePrograma" />
        </div>

        <!-- SEGUNDA LÍNEA -->
        <div class="d-flex gap-4">
            <div class="d-flex gap-2">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "ifPlan",
                    Name = "Plan",
                    Label = "Plan:",
                    Valor = Model.Plan,
                    Disabled = true,
                    Flexible = false
                })
                <input type="hidden" name="Plan" value="@Model.Plan" />

                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "ifSistema",
                    Name = "Sistema",
                    Label = "Sistema:",
                    Valor = Model.Sistema,
                    Disabled = true,
                    Flexible = false
                })
                <input type="hidden" name="Sistema" value="@Model.Sistema" />
            </div>
        </div>
        <!-- BOTÓN AGREGAR EXPERIENCIA EDUCATIVA -->
        <div class="d-flex col-12 justify-content-end">
            @await Component.InvokeAsync("Boton", new
            {
                accion = "Agregar",
                tipo = "secundario",
                texto = "Agregar Experiencia Educativa",
                OnClick = "abrirModalAgregarExperiencia()"
            })
        </div>
    </div>

    <!-- TABLA -->
    <div id="tabla" class="gap:10px;" style="margin-block-end: 1em">
        
        @await Component.InvokeAsync("Table", Model.Table)
    </div>

    <!-- BOTONES INFERIORES -->
    <div class="d-flex row">
        <div class="d-flex col-6">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Regresar",
                OnClick = "regresarPaso1()"
            })
        </div>
        <div class="d-flex col-6 column-gap-3 justify-content-end">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Cancelar",
                OnClick = "cancelarAccion()"
            })
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Guardar",
                ButtonType = "submit"
            })
        </div>
    </div>

    <!-- MODALES -->
    <div>
        <!-- Modal Perfil Docente -->
        @await Component.InvokeAsync("Modal", new ModalModel
        {
            Id = "modalPerfilDocente",
            Tipo = "info",
            Titulo = "Pefil docente",
            Mensaje = "",
            OnConfirm = "cerrarModal('modalPerfilDocente')"

        })
        <!-- Modal Agregar -->
        @Html.AntiForgeryToken()
            
        @await Component.InvokeAsync("ModalFormulario", new ModalFormularioModel
        {
            Id = "modalAgregarExperiencia",
            Titulo = "Agregar Experiencia Educativa",
            PartialView = "_FormularioAgregarExperiencia",
            PartialModel = Model.Formulario,
            OnConfirm = "agregarExperiencia(false)",
            OnCancel = "cerrarModal('modalAgregarExperiencia')"
        })

        <!-- Modal Editar -->
        @Html.AntiForgeryToken()
            
        @await Component.InvokeAsync("ModalFormulario", new ModalFormularioModel
        {
            Id = "modalEditarExperiencia",
            Titulo = "Editar Experiencia Educativa",
            PartialView = "_FormularioEditarExperiencia",
            PartialModel = Model.Formulario,
            OnConfirm = "editarExperiencia(false)",
            OnCancel = "cerrarModal('modalEditarExperiencia')"
        })

        <!-- Modal eliminar -->
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" id="deleteArticuloId" />

        @await Component.InvokeAsync("Modal", new ModalModel
        {
            Id = "modalEliminarExperiencia",
            Tipo = "confirm",
            Titulo = "Eliminar Experiencia Educativa",
            Mensaje = "Esta acción es irreversible ¿Está seguro de eliminar la Experiencia Educativa del Plan de Estudios?",
            OnConfirm = "eliminarExperiencia(false)",
            OnCancel = "cerrarModal('modalEliminarExperiencia')"
        })
    </div>
</form>

<script>
    const UrlAgregarExperiencia = '@Url.Action("AgregarExperienciaEducativaCreacion", "PlanesEstudios")';
    const UrlEditarExperiencia = '@Url.Action("EditarExperienciaEducativaCreacion", "PlanesEstudios")';
    const UrlEliminarExperiencia = '@Url.Action("EliminarExperienciaEducativaCreacion", "PlanesEstudios")';

    function abrirModalPerfilDocente(perfilDocente){
        document.getElementById("modalPerfilDocente-mensaje").innerText = perfilDocente;
        abrirModal("modalPerfilDocente");
    }

    async function regresarPaso1(){
        const region = document.getElementById("ifRegion").value;
        const area = document.getElementById("ifArea").value;
        const entidad = document.getElementById("entidad").value;
        const programa = document.getElementById("IdProgramaEducativo").value;
        const sistema = document.getElementById("ifSistema").value;
        const plan = document.getElementById("ifPlan").value;

        const response = await fetch('@Url.Action("RegresarPaso1", "PlanesEstudios")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                Region: region,
                IdAreaAcademica: area,
                IdEntidadAcademica: entidad,
                IdProgramaEducativo: programa,
                Plan: plan,
                Sistema: sistema
            })
        });
        const data = await response.json();
        window.location.href = data.url;
    }

    async function cancelarAccion(){
        const response = await fetch('@Url.Action("CancelarAccion","PlanesEstudios")');
        const data = await response.json();
        window.location.href = data.url;
    }
</script>

@section Scripts {
    <script src="~/js/gestionarExperiencias.js"></script>
}