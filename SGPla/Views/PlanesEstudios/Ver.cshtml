@using SGPla.Models.ViewModels.PlanesEstudios
@model PlanEstudiosMvcDetalleViewModel
@{ ViewData["Title"] = "Plan de Estudios"; var paginas = (int)Math.Ceiling(Model.TotalExperiencias / (double)Model.TamanoPagina); }
<div class="container py-3"><p><a asp-action="Index">← Planes de Estudio</a></p><h1>Plan @Model.Plan.Codigo</h1>
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <dl class="row"><dt class="col-sm-3">Programa</dt><dd class="col-sm-9">@Model.Plan.ProgramaEducativo</dd><dt class="col-sm-3">Entidad Académica</dt><dd class="col-sm-9">@Model.Plan.EntidadAcademica</dd><dt class="col-sm-3">Área académica</dt><dd class="col-sm-9">@Model.Plan.AreaAcademica</dd><dt class="col-sm-3">Región</dt><dd class="col-sm-9">@Model.Plan.Region</dd><dt class="col-sm-3">Sistema</dt><dd class="col-sm-9">@Model.Plan.SistemaEducativo</dd><dt class="col-sm-3">Nivel</dt><dd class="col-sm-9">@Model.Plan.NivelFormacion</dd></dl>
    <div class="d-flex justify-content-between align-items-center mt-4 mb-2"><h2 class="h4">Experiencias Educativas</h2><a asp-action="CrearExperiencia" asp-route-planId="@Model.Plan.Id" class="btn btn-primary">Agregar experiencia</a></div>
    <form asp-action="ImportarExcel" method="post" enctype="multipart/form-data" class="card card-body mb-3">
        @Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Plan.Id" />
        <div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label" for="archivo">Importar desde Excel (.xls/.xlsx, máximo 10 MB)</label><input type="file" id="archivo" name="archivo" class="form-control" accept=".xls,.xlsx" required /></div>
            <div class="col-md-5"><label class="form-label" for="areaFormacionId">Área de formación para las filas importadas</label><select id="areaFormacionId" name="areaFormacionId" class="form-select" required><option value="">Selecciona</option>@foreach (var area in Model.AreasFormacion) { <option value="@area.Id">@area.Nombre</option> }</select></div>
            <div class="col-md-2"><button class="btn btn-outline-primary w-100">Importar</button></div></div>
        <small class="form-text">El Excel se procesa temporalmente en memoria y no queda almacenado.</small>
    </form>
    <form method="get" asp-action="Ver" class="row g-2 mb-3"><input type="hidden" name="id" value="@Model.Plan.Id" /><div class="col-md-8"><input name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre o materia/curso" /></div><div class="col-md-2"><select name="tamanoPagina" class="form-select"><option value="20" selected="@(Model.TamanoPagina == 20)">20</option><option value="50" selected="@(Model.TamanoPagina == 50)">50</option><option value="100" selected="@(Model.TamanoPagina == 100)">100</option></select></div><div class="col-md-2"><button class="btn btn-secondary w-100">Buscar</button></div></form>
    <p>@Model.TotalExperiencias experiencia(s)</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Materia</th><th>Curso</th><th>Nombre</th><th>Horas teóricas</th><th>Horas prácticas</th><th>Créditos</th><th>Área de formación</th><th></th></tr></thead>
        <tbody>@foreach (var ee in Model.Experiencias) { <tr><td>@ee.MateriaEe</td><td>@ee.CursoEe</td><td>@ee.Nombre</td><td>@ee.HorasTeoricas</td><td>@ee.HorasPracticas</td><td>@ee.Creditos</td><td>@ee.AreaFormacion</td><td class="text-nowrap"><a asp-action="EditarExperiencia" asp-route-planId="@Model.Plan.Id" asp-route-id="@ee.Id" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="EliminarExperiencia" method="post" class="d-inline" onsubmit="return confirm('¿Dar de baja esta experiencia?');">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Plan.Id" /><input type="hidden" name="id" value="@ee.Id" /><button class="btn btn-sm btn-outline-danger">Dar de baja</button></form></td></tr> }</tbody>
    </table></div>
    @if (paginas > 1) { <nav aria-label="Paginación de experiencias"><ul class="pagination">@for (var p = 1; p <= paginas; p++) { <li class="page-item @(p == Model.Pagina ? "active" : "")"><a class="page-link" asp-action="Ver" asp-route-id="@Model.Plan.Id" asp-route-pagina="@p" asp-route-tamanoPagina="@Model.TamanoPagina" asp-route-busqueda="@Model.Busqueda">@p</a></li> }</ul></nav> }
</div>
