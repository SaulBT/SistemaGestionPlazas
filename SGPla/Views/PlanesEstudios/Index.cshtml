@using SGPla.Models.ViewModels.PlanesEstudios
@model PlanEstudiosMvcIndexViewModel
@{
    ViewData["Title"] = "Planes de Estudio";
    var paginas = (int)Math.Ceiling(Model.Total / (double)Model.Filtro.TamanoPagina);
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3"><h1>Planes de Estudio</h1><a asp-action="Crear" class="btn btn-primary">Crear Plan</a></div>
    <form method="get" asp-action="Index" class="card card-body mb-3"><div class="row g-3">
        <div class="col-md-3"><label asp-for="Filtro.RegionId" class="form-label">Región</label><select asp-for="Filtro.RegionId" class="form-select"><option value="">Todas</option>@foreach (var item in Model.Regiones) { <option value="@item.Id">@item.Nombre</option> }</select></div>
        <div class="col-md-3"><label asp-for="Filtro.AreaAcademicaId" class="form-label">Área académica</label><select asp-for="Filtro.AreaAcademicaId" class="form-select"><option value="">Todas</option>@foreach (var item in Model.Areas) { <option value="@item.Id">@item.Nombre</option> }</select></div>
        <div class="col-md-3"><label asp-for="Filtro.EntidadAcademicaId" class="form-label">Entidad Académica</label><select asp-for="Filtro.EntidadAcademicaId" class="form-select"><option value="">Todas</option>@foreach (var item in Model.Entidades) { <option value="@item.Id">@item.Nombre</option> }</select></div>
        <div class="col-md-3"><label asp-for="Filtro.ProgramaEducativoId" class="form-label">Programa Educativo</label><select asp-for="Filtro.ProgramaEducativoId" class="form-select"><option value="">Todos</option>@foreach (var item in Model.Programas) { <option value="@item.Id">@item.Nombre</option> }</select></div>
        <div class="col-md-8"><label asp-for="Filtro.Busqueda" class="form-label">Código o programa</label><input asp-for="Filtro.Busqueda" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="Filtro.TamanoPagina" class="form-label">Filas</label><select asp-for="Filtro.TamanoPagina" class="form-select"><option>10</option><option>20</option><option>50</option><option>100</option></select></div>
        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-secondary w-100">Filtrar</button></div>
    </div><input type="hidden" asp-for="Filtro.Pagina" value="1" /></form>
    <p>@Model.Total resultado(s)</p>
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th>Código</th><th>Programa</th><th>Entidad</th><th>Área</th><th>Región</th><th>Sistema</th><th>Nivel</th><th></th></tr></thead>
        <tbody>@foreach (var plan in Model.Items) { <tr>
            <td>@plan.Codigo</td><td>@plan.ProgramaEducativo</td><td>@plan.EntidadAcademica</td><td>@plan.AreaAcademica</td><td>@plan.Region</td><td>@plan.SistemaEducativo</td><td>@plan.NivelFormacion</td>
            <td class="text-nowrap"><a asp-action="Ver" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                <form asp-action="Eliminar" method="post" class="d-inline" onsubmit="return confirm('¿Dar de baja este Plan y sus experiencias vigentes?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@plan.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Dar de baja</button></form>
            </td></tr> }</tbody>
    </table></div>
    @if (paginas > 1) { <nav aria-label="Paginación"><ul class="pagination">@for (var p = 1; p <= paginas; p++) { <li class="page-item @(p == Model.Filtro.Pagina ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-Filtro.Pagina="@p" asp-route-Filtro.TamanoPagina="@Model.Filtro.TamanoPagina" asp-route-Filtro.Busqueda="@Model.Filtro.Busqueda" asp-route-Filtro.RegionId="@Model.Filtro.RegionId" asp-route-Filtro.AreaAcademicaId="@Model.Filtro.AreaAcademicaId" asp-route-Filtro.EntidadAcademicaId="@Model.Filtro.EntidadAcademicaId" asp-route-Filtro.ProgramaEducativoId="@Model.Filtro.ProgramaEducativoId">@p</a></li> }</ul></nav> }
</div>
