@using SGPla.Models.ViewModels.PlanesEstudios
@model IndexViewModel

@{
    Layout = "_LayoutSuperUsuario";
    ViewData["Title"] = "Planes de Estudios";
}

<form method="get" action="@Url.Action("Index", "PlanesEstudios")">

    <!-- Filtros -->
    <div style="display:inline-flex; gap:10px; padding-bottom:30px;">
        @await Component.InvokeAsync("SelectField", new SelectFieldModel
        {
            Id = "Region",
            Label = "Región",
            Options = Model.Regiones,
            Name = "region"
        })

        <div id="contenedorArea" style="display:none">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Id = "Area",
                Label = "Área Académica",
                Options = Model.Areas,
                Name = "idAreaAcademica"
            })
        </div>

        <div id="contenedorEntidad" style="display:none">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Id = "Entidad",
                Label = "Entidad Académica",
                Options = Model.Entidades,
                Name = "idEntidadAcademica"
            })
        </div>

        <div id="contenedorPrograma" style="display:none">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Id = "Programa",
                Label = "Programa Educativo",
                Options = Model.ProgramasEducativos,
                Name = "idProgramaEducativo"
            })
        </div>
    </div>

    <!-- Aacciones -->
    <div style="display:flex; gap:10px; padding-bottom:30px; align-items:center; justify-content:space-between">
        <!--Barra de Búsqueda-->
        @await Component.InvokeAsync("Buscador", new BuscadorModel
        {
            Name = "busqueda",
            Placeholder = "Buscar Plan de Estudios",
            Action = Url.Action("Index", "PlanesEstudios"),
            Method = "get",
            Value = Context.Request.Query["busqueda"]
        })

        <!--Botón Cargar Plan Estudios-->
        <a href="@Url.Action("CargarPlanPaso1", "PlanesEstudios")" style="display: inline-block; text-decoration: none;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Agregar",
                Texto = "Cargar Plan de Estudios"
            })
        </a>
    </div>
</form>

<!-- Tabla con Datos -->
<div style="display:flex; gap:10px; padding-top:20px;justify-content:left">
    @await Component.InvokeAsync("Table", Model.Table)
    
</div>

<script>
    const urlObtenerAreas =
        '@Url.Action("ObtenerAreas", "PlanesEstudios")';
    const urlObtenerEntidades =
        '@Url.Action("ObtenerEntidades", "PlanesEstudios")';
    const urlObtenerProgramas =
        '@Url.Action("ObtenerProgramas", "PlanesEstudios")';
</script>

@section Scripts {
    <script src="~/js/indexPlan.js"></script>
}