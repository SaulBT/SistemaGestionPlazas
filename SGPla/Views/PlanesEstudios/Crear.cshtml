@using SGPla.Models.ViewModels.PlanesEstudios
@model PlanEstudiosMvcCrearViewModel
@{ ViewData["Title"] = "Crear Plan de Estudios"; }
<div class="container py-3"><h1>Crear Plan de Estudios</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Crear" method="post" class="card card-body" style="max-width:720px">@Html.AntiForgeryToken()
        <div class="mb-3"><label asp-for="ProgramaEducativoId" class="form-label">Programa Educativo</label><select asp-for="ProgramaEducativoId" class="form-select"><option value="">Selecciona un programa</option>@foreach (var item in Model.Programas) { <option value="@item.Id">@item.Nombre (@item.Clave)</option> }</select><span asp-validation-for="ProgramaEducativoId" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Codigo" class="form-label">Código del Plan</label><input asp-for="Codigo" class="form-control" autocomplete="off" /><span asp-validation-for="Codigo" class="text-danger"></span><div class="form-text">Código opaco, hasta 50 caracteres. No se almacena un archivo del Plan.</div></div>
        <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Crear</button><a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
