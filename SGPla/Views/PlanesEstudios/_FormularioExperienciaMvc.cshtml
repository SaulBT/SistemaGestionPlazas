@using SGPla.Models.ViewModels.PlanesEstudios
@model PlanEstudiosMvcExperienciaViewModel
<div class="row g-3 mb-3">
    <div class="col-md-6"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="MateriaEe" class="form-label">Materia EE</label><input asp-for="MateriaEe" class="form-control" readonly="@(Model.Id > 0)" /><span asp-validation-for="MateriaEe" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="CursoEe" class="form-label">Curso EE</label><input asp-for="CursoEe" class="form-control" readonly="@(Model.Id > 0)" /><span asp-validation-for="CursoEe" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="HorasTeoricas" class="form-label">Horas teóricas</label><input asp-for="HorasTeoricas" type="number" min="0" class="form-control" readonly="@Model.DatosAcademicosBloqueados" /><span asp-validation-for="HorasTeoricas" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="HorasPracticas" class="form-label">Horas prácticas</label><input asp-for="HorasPracticas" type="number" min="0" class="form-control" readonly="@Model.DatosAcademicosBloqueados" /><span asp-validation-for="HorasPracticas" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Creditos" class="form-label">Créditos</label><input asp-for="Creditos" type="number" min="1" class="form-control" readonly="@Model.DatosAcademicosBloqueados" /><span asp-validation-for="Creditos" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="AreaFormacionId" class="form-label">Área de formación</label>@if (Model.DatosAcademicosBloqueados) { <select asp-for="AreaFormacionId" class="form-select" disabled><option value="">Selecciona</option>@foreach (var item in Model.AreasFormacion) { <option value="@item.Id">@item.Nombre</option> }</select><input asp-for="AreaFormacionId" type="hidden" /> } else { <select asp-for="AreaFormacionId" class="form-select"><option value="">Selecciona</option>@foreach (var item in Model.AreasFormacion) { <option value="@item.Id">@item.Nombre</option> }</select> }<span asp-validation-for="AreaFormacionId" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="PerfilDocente" class="form-label">Perfil docente</label><textarea asp-for="PerfilDocente" class="form-control" rows="4"></textarea><span asp-validation-for="PerfilDocente" class="text-danger"></span></div>
</div>
@if (Model.DatosAcademicosBloqueados) { <p class="form-text">Esta experiencia ya tiene programación académica. Horas, créditos y área de formación son inmutables; sólo pueden cambiar el nombre y el perfil docente.</p> }
