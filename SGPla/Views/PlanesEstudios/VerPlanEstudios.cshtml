@model SGPla.Models.ViewModels.PlanesEstudios.VerPlanEstudiosViewModel

@{
    ViewData["Title"] = "Plan de Estudios";
}

<div class="container-fluid">

    <!-- BLOQUE SUPERIOR -->
    <div class="d-flex gap-2">

        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "programaEducativo",
            Name = "programaEducativo",
            Label = "Programa Educativo:",
            Valor = Model.NombreProgramaEducativo,
            Disabled = true,
            Flexible = true
        })

        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "sistema",
            Name = "sistema",
            Label = "Sistema:",
            Valor = Model.Modalidad,
            Disabled = true,
            Flexible = true
        })

        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "plan",
            Name = "plan",
            Label = "Plan:",
            Valor = Model.Nombre,
            Disabled = true,
            Flexible = true
        })

        @await Component.InvokeAsync("InputField", new InputFieldModel
        {
            Id = "area",
            Name = "area",
            Label = "Área:",
            Valor = Model.NombreAreaAcademica,
            Disabled = true,
            Flexible = true
        })
    </div>

    <!-- BOTON DESCARGAR -->
    <div class="d-flex justify-content-end my-3">
        @await Component.InvokeAsync("Boton", new
        {
            accion = "descargar"
        })
    </div>

    <!-- TABLA -->
    <div class="gap:10px;">
        @await Component.InvokeAsync("Table", Model.Table)
    </div>

    <!-- BOTÓN REGRESAR -->
    <div class="row mt-3">
        <a href="@Url.Action("Index", "PlanesEstudios")" style="display: inline-block; text-decoration: none;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Regresar"
            })
        </a>
    </div>

    <!-- MODAL -->
    <div>
        @await Component.InvokeAsync("Modal", new ModalModel{
            Id = "modalPerfilDocente",
            Tipo = "info",
            Titulo = "Pefil docente",
            Mensaje = "",
            OnConfirm = "cerrarModal('modalPerfilDocente')"

        })
    </div>
</div>

<script>
    function abrirModalPerfilDocente(perfilDocente){
        document.getElementById("modalPerfilDocente-mensaje").innerText = perfilDocente;
        abrirModal("modalPerfilDocente");
    }
</script>