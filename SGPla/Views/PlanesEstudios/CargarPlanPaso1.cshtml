@model SGPla.Models.ViewModels.PlanesEstudios.CargarPlanPaso1ViewModel

@{
    ViewData["Title"] = "Cargar Plan de Estudios";
}

<form id="form" method="post" action="@Url.Action("CargarPlanPaso2", "PlanesEstudios")" enctype="multipart/form-data">
    <div class="d-flex flex-column gap-3">
        @await Component.InvokeAsync("SelectField", new SelectFieldModel
        {
            Label = "Región",
            Options = Model.ListaRegiones,
            Name = "Region"
        })

        <div id="contenedorArea" style="display:none;">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Label = "Área Académica",
                Options = Model.ListaAreas,
                Name = "Area"
            })
        </div>

        <div id="contenedorEntidad" style="display:none">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Label = "Entidad Académica",
                Options = Model.ListaEntidades,
                Name = "Entidad"
            })
        </div>

        <div id="contenedorPrograma" style="display:none;">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Label = "Programa Educativo",
                Options = Model.ListaProgramas,
                Name = "Programa"
            })
        </div>

        <div style="display:inline;">
            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Id = "Plan",
                Name = "Plan",
                Label = "Plan:",
                Valor = Model.Plan,
                Disabled = false,
                Flexible = false,
            })
        </div>

        <div style="display:inline;">
            @await Component.InvokeAsync("SelectField", new SelectFieldModel
            {
                Label = "Sistema",
                Options = Model.ListaSistema,
                Name = "Sistema"
            })
        </div>

        <!-- BOTÓN -->
        <div style="display:inline;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "cargar",
                Texto = "Subir Archivo",
                OnClick = "abrirModalArchivo()"
            })
        </div>
    </div>

    <!-- BOTONES -->
    <div style="display:flex; justify-content:flex-end; gap:var(--button-gap)">
        <a href="@Url.Action("Index", "PlanesEstudios")" style="display: inline-block; text-decoration: none;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Cancelar"
            })
        </a>
        @await Component.InvokeAsync("Boton", new
        {
            Accion = "siguiente",
            OnClick = "document.getElementById('form').submit()"
        })
    </div>

    <!-- MODAL -->
    <div>
        @await Component.InvokeAsync("ModalArchivo", new ModalArchivoModel
        {
            Id = "modalArchivo",
            FormatosAceptados = ".xlsx, .xls",
            TamanioMaximo = 20
        })
    </div>
</form>

<script>
    const UrlObtenerAreas = '@Url.Action("ObtenerAreas", "PlanesEstudios")';
    const UrlObtenerEntidades = '@Url.Action("ObtenerEntidades", "PlanesEstudios")';
    const UrlObtenerProgramas = '@Url.Action("ObtenerProgramas", "PlanesEstudios")';

    function abrirModalArchivo() {
        abrirModal("modalArchivo");
    }
</script>

@section Scripts {
    <script src="~/js/cargarArchivo.js"></script>
    <script src="~/js/cargarCatalogosPlan.js"></script>
}