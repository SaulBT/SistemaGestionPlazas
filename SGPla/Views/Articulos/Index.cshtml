@model IEnumerable<SGPla.Models.DTOs.Articulo.DetallesArticuloDTO>

<h2>Articulos</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Buscar" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="busqueda"
               class="form-control"
               placeholder="Buscar por número o descripción..."
               value="@Context.Request.Query["busqueda"]" />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Limpiar</a>
    </div>
</form>

<button class="btn btn-primary mb-3" onclick="abrirModalCrear()" >Agregar artículo</button>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Numero</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Numero</td>
                <td>@p.Descripcion</td>
                <td>
                    <button class="btn btn-sm btn-warning"
                            onclick="abrirModalActualizar(@p.IdArticulo, '@p.Numero', '@p.Descripcion')">
                        Editar
                    </button>
                    <form asp-action="Eliminar" asp-route-id="@p.IdArticulo" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" onclick="return confirm('¿Eliminar?')">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal compartido: Crear usa CrearArticuloDTO, Editar usa EditarArticuloDTO -->
<div class="modal fade" id="articuloModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="articuloForm" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nuevo Artículo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <!-- Solo se envía al editar, EditarArticuloDTO lo requiere -->
                    <!-- Al crear, CrearArticuloDTO no lo tiene, el binder lo ignora -->
                    <input type="hidden" id="IdArticulo" name="IdArticulo" />

                    <div class="mb-3">
                        <label>Numero</label>
                        <input type="text" id="Numero" name="Numero" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Descripcion</label>
                        <input type="text" id="Descripcion" name="Descripcion" class="form-control" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function abrirModalCrear() {
        document.getElementById("tituloModal").innerText = "Nuevo Artículo";
        document.getElementById("articuloForm").action = "/Articulos/Crear";

        document.getElementById("IdArticulo").value = "";
        document.getElementById("Numero").value = "";
        document.getElementById("Descripcion").value = "";

        new bootstrap.Modal(document.getElementById('articuloModal')).show();
    }

    function abrirModalActualizar(id, numero, descripcion) {
        document.getElementById("tituloModal").innerText = "Editar Artículo";
        document.getElementById("articuloForm").action = "/Articulos/Editar";

        document.getElementById("IdArticulo").value = id;
        document.getElementById("Numero").value = numero;
        document.getElementById("Descripcion").value = descripcion;

        new bootstrap.Modal(document.getElementById('articuloModal')).show();
    }
</script>