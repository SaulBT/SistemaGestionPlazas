@model SGPla.Models.ViewModels.EntidadesAcademicas.CrearEntidadAcademicaViewModel
@{
    Layout = "_LayoutSuperUsuario";
    ViewData["Title"] = "Crear Entidad Académica";
}

<form method="post" action="@Url.Action("CrearEntidadAcademica", "EntidadesAcademicas")" class="formulario-con-barra-acciones">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 p-3">
        <div class="col-md-3"><label asp-for="Clave" class="form-label">Clave</label><input asp-for="Clave" class="form-control" maxlength="50" autocomplete="off" /><span asp-validation-for="Clave" class="text-danger"></span></div>
        <div class="col-md-9"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" maxlength="200" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="RegionId" class="form-label">Región</label><select asp-for="RegionId" class="form-select" id="RegionId"><option value="">Seleccione una región</option>@foreach (var item in Model.Regiones) { <option value="@item.Value" selected="@item.Selected">@item.Text</option> }</select></div>
        <div class="col-md-4"><label asp-for="CampusId" class="form-label">Campus</label><select asp-for="CampusId" class="form-select" id="CampusId"><option value="">Seleccione un campus</option>@foreach (var item in Model.Campus) { <option value="@item.Value" selected="@item.Selected">@item.Text</option> }</select><span asp-validation-for="CampusId" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="AreaAcademicaId" class="form-label">Área académica</label><select asp-for="AreaAcademicaId" class="form-select"><option value="">Seleccione un área</option>@foreach (var item in Model.Areas) { <option value="@item.Value" selected="@item.Selected">@item.Text</option> }</select><span asp-validation-for="AreaAcademicaId" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Calle" class="form-label">Calle</label><input asp-for="Calle" class="form-control" maxlength="200" /><span asp-validation-for="Calle" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="NumeroExterior" class="form-label">Número exterior</label><input asp-for="NumeroExterior" class="form-control" maxlength="20" /></div>
        <div class="col-md-3"><label asp-for="Colonia" class="form-label">Colonia</label><input asp-for="Colonia" class="form-control" maxlength="150" /><span asp-validation-for="Colonia" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="MunicipioId" class="form-label">Municipio</label><select asp-for="MunicipioId" class="form-select"><option value="">Seleccione un municipio</option>@foreach (var item in Model.Municipios) { <option value="@item.Value" selected="@item.Selected">@item.Text</option> }</select><span asp-validation-for="MunicipioId" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="CodigoPostal" class="form-label">Código postal</label><input asp-for="CodigoPostal" class="form-control" inputmode="numeric" maxlength="5" /><span asp-validation-for="CodigoPostal" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" inputmode="numeric" maxlength="10" /><span asp-validation-for="Telefono" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Extension" class="form-label">Extensión (opcional)</label><input asp-for="Extension" class="form-control" inputmode="numeric" maxlength="10" /></div>
    </div>
    <div class="barra-acciones-fija"><a class="btn btn-secondary" href="@Url.Action("Index")">Cancelar</a><button class="btn btn-primary" type="submit">Guardar</button></div>
</form>

<script>
document.getElementById("RegionId").addEventListener("change", async event => {
    const campus = document.getElementById("CampusId");
    campus.replaceChildren(new Option("Seleccione un campus", ""));
    if (!event.target.value) return;
    const response = await fetch(`@Url.Action("Campus", "Catalogos")?regionId=${encodeURIComponent(event.target.value)}`);
    if (!response.ok) return;
    for (const item of await response.json()) campus.add(new Option(`${item.clave} - ${item.nombre}`, item.id));
});
</script>
