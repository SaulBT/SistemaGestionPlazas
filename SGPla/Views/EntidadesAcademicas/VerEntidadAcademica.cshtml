@model SGPla.Models.DTOs.EntidadAcademica.EntidadAcademicaMvcDto
@{
    Layout = "_LayoutSuperUsuario";
    ViewData["Title"] = "Entidad Académica";
}

<section class="container py-4">
    <h1>@Model.Nombre</h1>
    <dl class="row mt-4">
        <dt class="col-sm-3">Clave</dt><dd class="col-sm-9">@Model.Clave</dd>
        <dt class="col-sm-3">Campus</dt><dd class="col-sm-9">@Model.CampusNombre</dd>
        <dt class="col-sm-3">Región</dt><dd class="col-sm-9">@Model.RegionNombre</dd>
        <dt class="col-sm-3">Área académica</dt><dd class="col-sm-9">@Model.AreaAcademicaNombre</dd>
        <dt class="col-sm-3">Calle</dt><dd class="col-sm-9">@Model.Calle</dd>
        <dt class="col-sm-3">Número exterior</dt><dd class="col-sm-9">@(Model.NumeroExterior ?? "Sin número")</dd>
        <dt class="col-sm-3">Colonia</dt><dd class="col-sm-9">@Model.Colonia</dd>
        <dt class="col-sm-3">Código postal</dt><dd class="col-sm-9">@Model.CodigoPostal</dd>
        <dt class="col-sm-3">Municipio</dt><dd class="col-sm-9">@Model.MunicipioNombre</dd>
        <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Telefono</dd>
        <dt class="col-sm-3">Extensión</dt><dd class="col-sm-9">@(Model.Extension ?? "Sin extensión")</dd>
    </dl>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Regresar</a>
    <a class="btn btn-primary" href="@Url.Action("EditarEntidadAcademica", new { id = Model.Id })">Editar</a>
</section>
