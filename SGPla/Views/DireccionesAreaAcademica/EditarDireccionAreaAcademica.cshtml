
@using SGPla.Models.DTOs.AreaAcademica
@model DatosAreaAcademicaDTO

@{
    ViewData["Title"] = "Editar Dirección de Área Académica";
}

<!-- Campos -->
<form method="post" action="@Url.Action("EditarDireccionAreaAcademica", "DireccionesAreaAcademica")">

    @Html.AntiForgeryToken()
    <input type="hidden" name="idAreaAcademica" value="@Model.IdAreaAcademica" />

    <div style="padding-bottom:var(--padding-end); ">
        <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">
            @await Component.InvokeAsync("InputField", new InputFieldModel
            {
                Id = "nombre",
                Name = "nombre",
                Label = "Nombre:",
                Valor = Model.Nombre,
                Flexible = true,
                Error = ViewData.ModelState["nombre"]?.Errors.FirstOrDefault()?.ErrorMessage,
                MaximoCaracteres = 100
            })
        </div>

        <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">
            <div style="width:200%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "calleNumero",
                    Name = "calleNumero",
                    Label = "Domicilio (Calle y Número):",
                    Valor = Model.CalleNumero,
                    Flexible = true,
                    Error = ViewData.ModelState["calleNumero"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 150
                })
            </div>
            
            <div style="width:100%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "colonia",
                    Name = "colonia",
                    Label = "Colonia:",
                    Valor = Model.Colonia,
                    Flexible = true,
                    Error = ViewData.ModelState["colonia"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 100
                })
            </div>
            
            <div style="width:50%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "cp",
                    Name = "cp",
                    Label = "C.P. :",
                    Valor = Model.Cp,
                    Flexible = true,
                    Error = ViewData.ModelState["cp"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 5
                })
            </div>
            
            <div style="width:100%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "municipio",
                    Name = "municipio",
                    Label = "Municipio:",
                    Valor = Model.Municipio,
                    Flexible = true,
                    Error = ViewData.ModelState["municipio"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 100
                })
            </div>
            
        </div>

        <div style="display:flex; gap:10px; padding:var(--padding-sm); align-items:flex-start; justify-content:space-evenly;">
            <div style="width:100%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "telefono",
                    Name = "telefono",
                    Label = "Teléfono:",
                    Valor = Model.Telefono,
                    Flexible = true,
                    Error = ViewData.ModelState["telefono"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 10
                })
            </div>

            <div style="width:100%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "conmutador",
                    Name = "conmutador",
                    Label = "Conmutador:",
                    Valor = Model.Conmutador,
                    Flexible = true,
                    Error = ViewData.ModelState["conmutador"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 20
                })
            </div>
        
            <div style="width:100%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "extension",
                    Name = "extension",
                    Label = "Extensión:",
                    Valor = Model.Extension,
                    Flexible = true,
                    Error = ViewData.ModelState["extension"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 5
                })
            </div>

            <div style="width:100%">
                @await Component.InvokeAsync("InputField", new InputFieldModel
                {
                    Id = "fax",
                    Name = "fax",
                    Label = "Fax:",
                    Valor = Model.Fax,
                    Flexible = true,
                    Error = ViewData.ModelState["fax"]?.Errors.FirstOrDefault()?.ErrorMessage,
                    MaximoCaracteres = 20
                })
            </div>
        </div>
    </div>

    <!-- Botones -->
    <div style="display:flex; justify-content:flex-end; gap:var(--button-gap)">
        <a href="@Url.Action("Index", "DireccionesAreaAcademica")" style="display: inline-block; text-decoration: none;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Cancelar"
            })
        </a>
        @await Component.InvokeAsync("Boton", new
        {
            Accion = "Guardar",
            ButtonType = "submit"
        })
    </div>

</form>

<script>

</script>
