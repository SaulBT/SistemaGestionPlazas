@model ModalModel

<div class="modal-overlay" id="@Model.Id">

    <div class="modal-container">

        <!-- Header -->
        <div class="modal-header">
            <h3>@Model.Titulo</h3>
        </div>

        <!-- Body -->
        <div class="modal-body">
            <p>@Model.Mensaje</p>
        </div>

        <!-- Footer -->
        <div class="modal-footer">

            @if (Model.Tipo == "confirm")
            {
                @await Component.InvokeAsync("Boton", new
                {
                    Accion = "Cancelar",
                    OnClick = Model.OnCancel
                })
            }
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Confirmar",
                OnClick = Model.OnConfirm
            })

        </div>

    </div>

</div>