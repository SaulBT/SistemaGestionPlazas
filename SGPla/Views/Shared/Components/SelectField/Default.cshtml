@model SelectFieldModel

<div class="select-field">
    @if (!string.IsNullOrWhiteSpace(Model.Label))
    {
        <div class="text-wrapper" >
            @Model.Label
        </div>
    }

    <div class="select-wrapper">
        <select class="select" 
                id="@Model.Id"
                name="@Model.Name"
                disabled="@(Model.Disabled ? "disabled" : null)">

            @* Placeholder opcional *@
            @if (!string.IsNullOrWhiteSpace(Model.Placeholder))
            {
                <option value=""
                        selected="@(Model.Options.All(o => !o.Selected) ? "selected" : null)">
                    @Model.Placeholder
                </option>
            }

            @foreach (var option in Model.Options)
            {
                <option value="@option.Value"
                        selected="@(option.Selected ? "selected" : null)">
                    @option.Text
                </option>
            }
        </select>

        <i class="bi bi-caret-down-fill select-icon"></i>
    </div>
</div>