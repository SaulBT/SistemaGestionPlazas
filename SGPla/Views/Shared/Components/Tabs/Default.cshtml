@model SGPla.Models.Components.TabsModel

<div class="tabs-container" id="@Model.Id">

    <div class="tabs-header" role="tablist" aria-label="Secciones">

        @for (int i = 0; i < Model.Tabs.Count; i++)
        {
            var tab = Model.Tabs[i];

            <button type="button"
                    id="@Model.Id-tab-@i" role="tab" aria-controls="@Model.Id-panel-@i"
                    aria-selected="@(i == Model.TabActivaPorDefecto ? "true" : "false")"
                    tabindex="@(i == Model.TabActivaPorDefecto ? "0" : "-1")"
                    class="tab-button @tab.EstadoClase @(i == Model.TabActivaPorDefecto ? "active" : "")"
                    onclick="seleccionarTab('@Model.Id', @i)">

                @if (!string.IsNullOrEmpty(tab.IconClass))
                {
                    <i class="@tab.IconClass" aria-hidden="true"></i>
                }

                <span>@tab.Titulo</span>
                @if (tab.Cantidad.HasValue)
                {
                    <span class="tab-count">@tab.Cantidad</span>
                }

            </button>
        }

    </div>

    <div class="tabs-body">

        @for (int i = 0; i < Model.Tabs.Count; i++)
        {
            var tab = Model.Tabs[i];

            <div id="@Model.Id-panel-@i" role="tabpanel" aria-labelledby="@Model.Id-tab-@i" tabindex="0" class="tab-content @(i == Model.TabActivaPorDefecto ? "active" : "")">

                @await Html.PartialAsync(
                    tab.PartialView,
                    tab.PartialModel
                )

            </div>
        }

    </div>

</div>
<script src="~/js/tabs.js" asp-append-version="true"></script>