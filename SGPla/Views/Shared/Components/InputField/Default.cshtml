@model InputFieldModel

<div class="input-field @(Model.Flexible ? "flexible" : "")">

    @if (!string.IsNullOrWhiteSpace(Model.Label))
    {
        <div class="text-wrapper">
            @Model.Label
        </div>
    }

    <input class="input @( !string.IsNullOrEmpty(Model.Error) ? "input-error" : "" )"
           id="@Model.Id"
           name="@Model.Name"
           value="@Model.Valor"
           placeholder="@Model.Placeholder"
           type="@Model.Tipo"
            @(Model.Disabled ? "disabled" : null) maxlength="@Model.MaximoCaracteres"/>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <span class="input-error-text">@Model.Error</span>
    }
</div>