@using SGPla.Commons
@model AvisoTarjetaModel

<div class="aviso-tarjeta">
	<div class="aviso-tarjeta-contenido">
		<div class="aviso-tarjeta-datos">
			<div>
				<strong>Folio: </strong>@Model.Folio
			</div>

			<div>
				<strong>Periodo: </strong>@Model.Periodo
			</div>

			<div>
				<strong>Artículo: </strong>@Model.Articulo
			</div>
		</div>
		@switch (Model.Estado)
		{
			case Constantes.CREADO:
				<div class="aviso-tarjeta-estado-texto-creado">
					@Model.Estado
					<span class="estado-dot-creado"></span>
				</div>
				break;
			case Constantes.EN_REVISION_POR_DGAA:
				<div class="aviso-tarjeta-estado-texto-revision">
					@Model.Estado
					<span class="estado-dot-revision"></span>
				</div>
				break;
			case Constantes.AVALADO_POR_DGAA:
				<div class="aviso-tarjeta-estado-texto-avalado">
					@Model.Estado
					<span class="estado-dot-avalado"></span>
				</div>
				break;
			case Constantes.DEVUELTO_POR_DGAA:
				<div class="aviso-tarjeta-estado-texto-devuelto">
					@Model.Estado
					<span class="estado-dot-devuelto"></span>
				</div>
				break;
			case Constantes.FIRMADO:
				<div class="aviso-tarjeta-estado-texto-firmado">
					@Model.Estado
					<span class="estado-dot-firmado"></span>
				</div>
				break;
			case Constantes.PUBLICADO:
				<div class="aviso-tarjeta-estado-texto-publicado">
					@Model.Estado
					<span class="estado-dot-publicado"></span>
				</div>
				break;
			case Constantes.ACTA_DE_CT_CREADA:
				<div class="aviso-tarjeta-estado-texto-acta">
					@Model.Estado
					<span class="estado-dot-acta"></span>
				</div>
				break;
		}
	</div>

	<div class="aviso-tarjeta-fecha">
		Fecha de creación: @Model.FechaCreacion
	</div>

	<div class="aviso-tarjeta-acciones">
		@switch (Model.Estado)
		{
			case Constantes.CREADO:
				<a href="@Url.Action("EnviarARevision", "Avisos", new { Model.IdAviso })">
					@await Component.InvokeAsync("Boton", new
					{
						texto = "Enviar a revisión por DGAA",
						accion = "enviar",
						tipo = "terciario"
					})
				</a>
				<a href="@Url.Action("ObtenerVistaPreviaAviso", "Avisos", new { idAviso = Model.IdAviso })" target="_blank" rel="noopener">
					@await Component.InvokeAsync("Boton", new { texto = "Ver Aviso", tipo = "secundario" })
				</a>
                @await Component.InvokeAsync("Boton", new
                {
                    accion = "editar",
                    fondo = false,
                    ariaLabel = "Editar aviso",
                    url = Url.Action("EditarAviso", "Avisos", new { idAviso = Model.IdAviso })
                })
				@await Component.InvokeAsync("Boton", new
				{
					accion = "eliminar",
					fondo = false,
					ariaLabel = "Eliminar aviso",
					OnClick = $"abrirModalEliminar({Model.IdAviso})"
				})
				break;

			case Constantes.EN_REVISION_POR_DGAA:
				<a href="@Url.Action("ObtenerVistaPreviaAviso", "Avisos", new { idAviso = Model.IdAviso })" target="_blank" rel="noopener">
					@await Component.InvokeAsync("Boton", new { texto = "Ver Aviso", tipo = "secundario" })
				</a>
				break;

			case Constantes.AVALADO_POR_DGAA:
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Firmar",
					accion = "firmar",
					tipo = "terciario",
					OnClick = $"abrirModalFirmar({Model.IdAviso})"
				})
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Ver comentarios",
					tipo = "secundario",
					OnClick = $"abrirModalComentarios('{Model.Comentarios}')"
				})
				<a href="@Url.Action("ObtenerVistaPreviaAviso", "Avisos", new { idAviso = Model.IdAviso })" target="_blank" rel="noopener">
					@await Component.InvokeAsync("Boton", new { texto = "Ver Aviso", tipo = "secundario" })
				</a>
				break;

			case Constantes.DEVUELTO_POR_DGAA:
				<a href="@Url.Action("EnviarARevision", "Avisos", new { Model.IdAviso })">
					@await Component.InvokeAsync("Boton", new
					{
						texto = "Enviar a revisión por DGAA",
						accion = "enviar",
						tipo = "terciario",
					})
				</a>
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Ver comentarios",
					tipo = "secundario",
					OnClick = $"abrirModalComentarios('{Model.Comentarios}')"
				})
				<a href="@Url.Action("ObtenerVistaPreviaAviso", "Avisos", new { idAviso = Model.IdAviso })" target="_blank" rel="noopener">
					@await Component.InvokeAsync("Boton", new { texto = "Ver Aviso", tipo = "secundario" })
				</a>
                @await Component.InvokeAsync("Boton", new
                {
                    accion = "editar",
                    fondo = false,
                    ariaLabel = "Editar aviso",
                    url = Url.Action("EditarAviso", "Avisos", new { idAviso = Model.IdAviso })
                })
				break;

			case Constantes.FIRMADO:
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Publicar",
					tipo = "publicar",
					OnClick = $"abrirModalPublicar({Model.IdAviso})"
				})
				<a href="@Url.Action("ObtenerVistaPreviaAviso", "Avisos", new { idAviso = Model.IdAviso })" target="_blank" rel="noopener">
					@await Component.InvokeAsync("Boton", new { texto = "Ver Aviso", tipo = "secundario" })
				</a>
				break;

			case Constantes.PUBLICADO:
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Generar Acta CT",
					tipo = "terciario"
				})
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Gestionar solicitantes",
					tipo = "terciario",
					accion = "agregar"
				})
				<a href="@Url.Action("VistaPreviaAviso", "Avisos", new { idAviso = Model.IdAviso })">
					@await Component.InvokeAsync("Boton", new { texto = "Ver Aviso", tipo = "secundario" })
				</a>
				break;
			case Constantes.ACTA_DE_CT_CREADA:
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Ver Acta",
					tipo = "secundario"
				})
				@await Component.InvokeAsync("Boton", new
				{
					texto = "Ver Aviso",
					tipo = "secundario"
				})
				@await Component.InvokeAsync("Boton", new
				{
					accion = "archivar",
					fondo = false,
					ariaLabel = Model.Archivado ? "Desarchivar aviso" : "Archivar aviso",
					OnClick = $"archivarAsync({Model.IdAviso}, {Model.Archivado.ToString().ToLower()})"
				})
				break;
		}
	</div>
</div>
