@model BotonModel

<button type="@Model.ButtonType"
        class="boton-primario @(Model.Fondo ? $"boton-{Model.Tipo}" : "boton-icono")"
        disabled="@(Model.Disabled ? "disabled" : null)"
    @( (Model.Accion == "siguiente" || Model.Accion == "ver mas") ? "style=\"flex-direction: row-reverse\"" : "" )>

    @if (!string.IsNullOrWhiteSpace(Model.Icono))
    {
        <i class="@Model.Icono"></i>
    }

    <span class="text-wrapper">
        @Model.Texto
    </span>
</button>