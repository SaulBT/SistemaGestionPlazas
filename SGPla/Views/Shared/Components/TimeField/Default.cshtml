@model TimeFieldModel

<div class="time-field">

    @if (!string.IsNullOrWhiteSpace(Model.Label))
    {
        <label class="text-wrapper" for="@Model.Id">
            @Model.Label
        </label>
    }

    <input type="time"
           id="@Model.Id"
           name="@Model.Name"
           value="@Model.Value"
           min="@Model.Min"
           max="@Model.Max"
           class="input time-input @( !string.IsNullOrEmpty(Model.Error) ? "input-error" : "" )"
           disabled="@(Model.Disabled ? "disabled" : null)" />

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <span id="@Model.Id-Error" class="input-error-text">
            @Model.Error
        </span>
    }

</div>