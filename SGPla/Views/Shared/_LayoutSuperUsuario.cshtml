<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiApp</title>
    
    <!-- Bootstrap 5 (para estilos básicos) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome (para iconos) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <!-- Tus estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/components/components.css" />
</head>
<body>

    <!-- ========================================== -->
    <!-- HEADER SUPERIOR (fijo en la parte de arriba) -->
    <!-- ========================================== -->
    <header class="header-superior">
        <div class="header-contenido">
            
            <!-- Logo o título -->
            <div class="logo">
                <!--<i class="fas fa-code"></i> -->
                <span>Sistema de Gestión de Plazas Vacantes</span>
            </div>
            
            <!-- Información del usuario -->
            <div class="info-usuario">
                <i class="fas fa-user-circle"></i>
                <div>
                    <span>Usuario Demo</span>
                    <span>Administrador del sistema</span>
                </div>
            </div>
        </div>
    </header>

    <!-- ========================================== -->
    <!-- CONTENEDOR PRINCIPAL (menú izquierdo + contenido) -->
    <!-- ========================================== -->
    <div class="contenedor-principal">
        
        <!-- MENÚ LATERAL IZQUIERDO -->
        <nav class="menu-lateral" id="menuLateral">
            <div class="menu-items">

                <!-- Usuarios -->
                <a href="/Usuarios" class="menu-item @(IsActiveController("Usuarios"))">
                    <span>Usuarios</span>
                </a>
                
                <!-- Articulos -->
                <a href="/Articulos" class="menu-item @(IsActiveController("Articulos"))">
                    <span>Articulos</span>
                </a>

                <!-- Direcciones de Área Académica -->
                <a href="/DireccionesAreaAcademica" class="menu-item @(IsActiveController("DireccionesAreaAcademica"))">
                    <span>Direcciones de Área Académica</span>
                </a>

                <!-- Entidades Académicas -->
                <a href="/EntidadesAcademicas" class="menu-item @(IsActiveController("EntidadesAcademicas"))">
                    <span>Entidades Académicas</span>
                </a>

                <!-- Programas Educativos -->
                <a href="/ProgramasEducativos" class="menu-item @(IsActiveController("ProgramasEducativos"))">
                    <span>Programas Educativos</span>
                </a>

                <!-- Planes de Estudios -->
                <a href="/PlanesEstudios" class="menu-item @(IsActiveController("PlanesEstudios"))">
                    <span>Planes de Estudio</span>
                </a>

                <!-- Periodos Escolares-->
                <a href="/PeriodosEscolares" class="menu-item @(IsActiveController("PeriodosEscolares"))">
                    <span>Periodos Escolares</span>
                </a>
            </div>
        </nav>

        <!-- CONTENIDO PRINCIPAL (aquí irá cada página) -->
        <main class="contenido-principal">
            <div class="contenido-pagina">
                @{
                    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var action = ViewContext.RouteData.Values["Action"]?.ToString();

                    var esInicio = controller == "Home" && action == "Index";
                }
                <!-- CABECERA DINÁMICA -->
                <div class="cabecera-seccion mb-3">

                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="titulo-seccion mb-0">
                            @ViewData["Title"]
                        </h2>
        
                        @{
                            var regresarUrl = ViewBag.RegresarUrl ?? ViewData["RegresarUrl"];
                            var regresarOnClick = ViewBag.RegresarOnClick ?? ViewData["RegresarOnClick"];
                            var mostrarBoton = !string.IsNullOrEmpty(regresarUrl?.ToString()) ||
                                              !string.IsNullOrEmpty(regresarOnClick?.ToString());
                        }
        
                        @if (mostrarBoton)
                        {
                            if (!string.IsNullOrEmpty(regresarUrl?.ToString()))
                            {
                                // Opción 1: Redirección por URL
                                <a href="@regresarUrl"
                                       style="display: inline-block; text-decoration: none;">
                                    @await Component.InvokeAsync("Boton", new { Accion = "Regresar" })
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(regresarOnClick?.ToString()))
                            {
                                // Opción 2: Evento JavaScript personalizado
                                @await Component.InvokeAsync("Boton", new
                                {
                                    Accion = "Regresar",
                                    OnClick = regresarOnClick
                                })
                            }
                        }
                    </div>

                    

                    @if (!esInicio)
                    {
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">

                                <li class="breadcrumb-item">
                                    <a href="/">Inicio</a>
                                </li>

                                @if (!string.IsNullOrEmpty(controller))
                                {
                                    <li class="breadcrumb-item">
                                        @Humanize(controller)
                                    </li>
                                }

                                @if (!string.IsNullOrEmpty(action) && action != "Index")
                                {
                                    <li class="breadcrumb-item active">
                                        @Humanize(action)
                                    </li>
                                }

                            </ol>
                        </nav>
                    }

                </div>

                <!-- CONTENIDO REAL -->
                @RenderBody()

            </div>
        </main>
    </div>

    <!-- TOASTS GLOBALES -->
    @using SGPla.Models.Componentes

@if (TempData["Success"] != null)
    {
        @await Component.InvokeAsync("Toast", new ToastModel
        {
            Id = "toastSuccess",
            Titulo = "Éxito",
            Mensaje = TempData["Success"]!.ToString(),
            Tipo = "success"
        })

        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    mostrarToast("toastSuccess");
                });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        @await Component.InvokeAsync("Toast", new ToastModel
        {
            Id = "toastError",
            Titulo = "Error",
            Mensaje = TempData["Error"]!.ToString(),
            Tipo = "error"
        })

        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    mostrarToast("toastError");
                });
        </script>
    }

    @if (TempData["Info"] != null)
    {
        @await Component.InvokeAsync("Toast", new ToastModel
        {
            Id = "toastInfo",
            Titulo = "Información",
            Mensaje = TempData["Info"]!.ToString(),
            Tipo = "info"
        })

        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    mostrarToast("toastInfo");
                });
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        @await Component.InvokeAsync("Toast", new ToastModel
        {
            Id = "toastWarning",
            Titulo = "Advertencia",
            Mensaje = TempData["Warning"]!.ToString(),
            Tipo = "warning"
        })

        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    mostrarToast("toastWarning");
                });
        </script>
    }

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private string IsActiveController(string controllerName)
    {
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        return currentController == controllerName ? "active" : "";
    }

    private string Humanize(string text)
    {
        if (string.IsNullOrEmpty(text)) return text;

        // Separar camel case: VerUsuario -> Ver Usuario
        var result = System.Text.RegularExpressions.Regex
            .Replace(text, "([a-z])([A-Z])", "$1 $2");

        return result;
    }
}