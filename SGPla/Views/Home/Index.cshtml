@{
    Layout = "_LayoutSuperUsuario";
    ViewData["Title"] = "Home Page";
}

<div class="text-center" >
    <h1>Componentes creados</h1>
</div>

<!-- Botones -->
<div style="padding-left: 20px;">

    <h2>Botones </h2>
    <!-- Botones sin ícono -->
    <div style="margin-left: 20px;">
        <h4> Botones con texto personalizado </h4>
        @await Component.InvokeAsync("Boton", new
        {
            texto = "Texto primario"
        })
        @await Component.InvokeAsync("Boton", new
        {
            texto = "Texto secundario",
            tipo = "secundario"
        })
        @await Component.InvokeAsync("Boton", new
        {
            texto = "Texto terciario",
            tipo = "terciario"
        })
        @await Component.InvokeAsync("Boton", new
        {
            texto = "Texto con más información",
            accion = "ver mas"
        })
        <br />
        <br />
    </div>

    <!-- Botones primarios -->
    <div style="margin-left: 20px;">
        <h4> Botones primarios</h4>
        @await Component.InvokeAsync("Boton", new
        {
            accion = "guardar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "agregar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "descargar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "enviar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "confirmar"
        })
        <br />
        <br />
    </div>

    <!-- Botones secundarios -->
    <div style="margin-left: 20px;">
        <h4> Botones secundarios</h4>
        @await Component.InvokeAsync("Boton", new
        {
            accion = "siguiente"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "regresar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "cargar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "buscar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "firmar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "AGREGAR",
            tipo = "secundario"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "enviar",
            tipo = "secundario"
        })
        <br />
        <br />
    </div>
    
    <!-- Botones terciarios -->
    <div style="margin-left: 20px;">
        <h4> Botones terciarios </h4>
        @await Component.InvokeAsync("Boton", new
        {
            accion = "imprimir"
        })
        <br />
        <br />
    </div>
    
    <!-- Botones con colores específicos según la acción -->
    <div style="margin-left: 20px;">
        <h4> Botones con colores específicos según la acción</h4>
        @await Component.InvokeAsync("Boton", new
        {
            accion = "cancelar"
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "publicar"
        })
        <br />
        <br />
    </div>

    <!-- Botones sin fondo -->
    <div style="margin-left: 20px;">
        <h4> Botones sin fondo </h4>
        @await Component.InvokeAsync("Boton", new
        {
            accion = "editar",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "eliminar",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "ver",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "archivar",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "informacion",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "programa educativo",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "plan de estudios",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "agregar",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "aspirante",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "derecha",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "izquierda",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "firmar",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "solicitudes",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "historial",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "excel",
            fondo = false
        })
        @await Component.InvokeAsync("Boton", new
        {
            accion = "pdf",
            fondo = false
        })
        <br />
        <br />
    </div>
    
    
</div>

