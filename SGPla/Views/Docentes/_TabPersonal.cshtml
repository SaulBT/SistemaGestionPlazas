@using SGPla.Models.ViewModels.Docentes
@model TabIndexViewModel
@{
    var esAsignacion = Model.IdOferta > 0;
    var accionBusqueda = esAsignacion
        ? Url.Action("AsignarDocente", "Docentes", new { idOferta = Model.IdOferta })
        : Url.Action("Index", "Docentes");
}

<form id="filtrosForm" method="get" action="@accionBusqueda">
    @if (esAsignacion)
    {
        <input type="hidden" name="idOferta" value="@Model.IdOferta" />
    }
    <input id="paginaHidden" type="hidden" name="pagina" value="1" />
    <input id="cantidadHidden" type="hidden" name="cantidad" value="@(Context.Request.Query["cantidad"].FirstOrDefault() ?? "10")" />
    <div style="display:flex; gap:10px; padding-bottom:20px; padding-top:20px; align-items:center; justify-content:space-between">
        <!-- Barra de búsqueda -->
        @await Component.InvokeAsync("Buscador", new BuscadorModel
        {
            Name = "busqueda",
            Placeholder = "Buscar al Personal",
            Action = accionBusqueda,
            Method = "get",
            Value = Context.Request.Query["busqueda"]
        })
        <!-- Botón -->
        <a href="@Model.AccionBoton" style="display: inline-block; text-decoration: none;">
            @await Component.InvokeAsync("Boton", new
            {
                Accion = "Agregar",
                Texto = "Nuevo Personal"
            })
        </a>
    </div>
</form>

<!-- Tabla -->
<div>
    @await Component.InvokeAsync("Table", Model.Tabla)
</div>
